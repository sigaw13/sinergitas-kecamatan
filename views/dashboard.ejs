<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard SIESELON</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; background: #f4f6fb; color: #273142; }
    .navbar { background: linear-gradient(135deg,#5d73df,#7047a5); color:#fff; padding:14px 26px; display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; box-shadow:0 2px 12px rgba(0,0,0,.12); }
    .navbar h1 { font-size:20px; }
    .nav-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .navbar a { color:#fff; text-decoration:none; background:rgba(255,255,255,.17); padding:8px 12px; border-radius:7px; font-size:13px; }
    .container { max-width: 1440px; margin: 28px auto; padding: 0 18px; }
    .card, .table-card, .countdown { background:#fff; border-radius:13px; box-shadow:0 3px 14px rgba(25,42,70,.08); padding:22px; margin-bottom:22px; }
    .intro h2 { margin-bottom:8px; }
    .muted { color:#687386; line-height:1.55; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:18px; margin-bottom:22px; }
    .instrument-card { background:#fff; border-radius:12px; box-shadow:0 3px 14px rgba(25,42,70,.08); padding:20px; border-left:5px solid #667eea; }
    .instrument-card h3 { font-size:17px; color:#4e63c8; margin-bottom:8px; }
    .instrument-card p { font-size:13px; color:#687386; line-height:1.5; min-height:58px; }
    .metric { font-size:42px; font-weight:800; text-align:center; color:#5e70d9; margin:8px 0; }
    .progress { height:22px; background:#e7eaf1; border-radius:999px; overflow:hidden; margin:10px 0; min-width:100px; }
    .bar { height:100%; background:linear-gradient(90deg,#5d73df,#7047a5); color:#fff; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center; min-width:0; }
    .progress-meta { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:10px 0 14px; }
    .progress-meta div { background:#f7f8fc; padding:8px; border-radius:7px; font-size:12px; color:#4d586b; }
    .btn { display:inline-block; border:0; border-radius:7px; padding:9px 14px; text-decoration:none; color:#fff; background:linear-gradient(135deg,#5d73df,#7047a5); font-size:13px; cursor:pointer; }
    .btn-secondary { background:#687386; }
    .badge { display:inline-block; padding:4px 9px; border-radius:999px; font-size:11px; font-weight:700; margin-left:5px; }
    .badge-sudah { background:#d7f2df; color:#166534; }
    .badge-draft { background:#fff1c7; color:#7c5700; }
    .badge-belum { background:#f9d9df; color:#922b3e; }
    .badge-verified { background:#d7f2df; color:#166534; }
    .badge-revision { background:#f9d9df; color:#922b3e; }
    .badge-pending { background:#fff1c7; color:#7c5700; }
    .evaluation-note { margin-top:10px; padding:10px; border-radius:8px; background:#fff8df; border-left:4px solid #d49a00; font-size:12px; color:#6b5200; }
    .countdown { border-left:5px solid #efb400; background:linear-gradient(135deg,#fffaf0,#fff1c7); }
    #countdown { font-size:24px; font-weight:800; color:#7c5700; margin-top:7px; }
    .message { padding:13px 15px; border-radius:8px; margin-bottom:16px; }
    .success { background:#d7f2df; color:#166534; border-left:4px solid #22a447; }
    .error { background:#f9d9df; color:#922b3e; border-left:4px solid #dc3545; }
    .table-card { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; min-width:1180px; }
    th,td { padding:10px; border-bottom:1px solid #e2e5ec; vertical-align:middle; font-size:12px; }
    th { background:#5d73df; color:#fff; text-align:left; position:sticky; top:0; }
    tr:hover td { background:#fafbfe; }
    .mini-progress { width:94px; }
    .mini-progress .progress { height:18px; margin:0; }
    .mini-progress .bar { font-size:10px; }
    .subtle { color:#7b8495; font-size:11px; margin-top:3px; }
    .legend { padding:12px; background:#f7f8fc; border-radius:8px; font-size:12px; color:#5d6678; margin-top:12px; }
    @media (max-width:720px) { .navbar { padding:12px 15px; } .container { padding:0 10px; } .progress-meta { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <nav class="navbar">
    <h1>📊 Sistem Informasi Evaluasi Sinergitas Kinerja dan Laporan Kecamatan (SIESELON)</h1>
    <div class="nav-actions">
      <span>👤 <%= username %><%= !isAdmin ? ' — ' + kecamatan : ' — Administrator' %></span>
      <% if (isAdmin) { %>
        <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
          <a href="/admin/settings">⚙️ Pengaturan</a>
          <a href="/admin/users">👥 Evaluator</a>
          <a href="/interview-recap">🎙️ Rekap Wawancara</a>
          <a href="/assessment/preview-logs">👁️ Log Preview</a>
        <% } %>
        <a href="/evaluation">✅ Verifikasi dan Finalisasi</a>
        <a href="/ranking">🏆 Peringkat</a>
        <a href="/report">📋 Progres Pengisian</a>
        <a href="/official-report">📑 Hasil Resmi</a>
        <a href="/history">📅 Riwayat</a>
        <a href="/export/official.csv">📥 Ekspor Hasil Resmi</a>
      <% } else { %>
        <a href="/assessment/scoring">📊 Lihat Skor</a>
      <% } %>
      <a href="/account/password">🔐 Ubah Password</a>
      <a href="/logout">Keluar</a>
    </div>
  </nav>

  <main class="container">
    <% if (success) { %><div class="message success">✅ Data berhasil disimpan.</div><% } %>
    <% if (error) { %><div class="message error">⚠️ <%= error %></div><% } %>

    <section class="card intro">
      <h2>Ringkasan Pengisian Instrumen A–F</h2>
      <p class="muted">Persentase progres menunjukkan kelengkapan isian dan bukti dukung. Skor otomatis mengikuti standar nilai workbook 2026 dan hanya diberikan pada indikator yang memiliki bukti dukung aktif.</p>
    </section>

    <% if (!isAdmin) { %>
      <section class="countdown">
        <h2>⏰ Batas Waktu Pengisian</h2>
        <p>Batas waktu aktif: <strong><%= deadline %></strong></p>
        <div id="countdown">Menghitung sisa waktu...</div>
      </section>

      <section class="card">
        <h2>✅ Status Evaluasi Kinerja</h2>
        <p class="muted">Administrator memverifikasi data dan bukti dukung setelah instrumen dikirim final. Skor menjadi hasil resmi setelah seluruh Instrumen A–F terverifikasi dan evaluasi difinalkan.</p>
        <div class="grid" style="margin-top:14px;margin-bottom:0">
          <div class="instrument-card"><h3>Instrumen Terverifikasi</h3><div class="metric"><%= evaluationSummary.verifiedCount %>/6</div></div>
          <div class="instrument-card"><h3>Perlu Perbaikan</h3><div class="metric"><%= evaluationSummary.revisionCount %></div></div>
          <div class="instrument-card"><h3>Status Hasil</h3><div class="metric" style="font-size:27px"><%= evaluationSummary.finalStatus %></div>
            <% if (evaluationSummary.finalResult && evaluationSummary.finalResult.status === 'Final') { %>
              <p style="min-height:0;text-align:center">Skor resmi <strong><%= evaluationSummary.finalResult.total_score %>/<%= evaluationSummary.finalResult.max_score %></strong> — <%= evaluationSummary.finalResult.category %></p>
              <p style="min-height:0;text-align:center"><a class="btn" href="/official-report/<%= evaluationSummary.finalResult.kecamatan_id %>">Buka Hasil Resmi</a></p>
            <% } %>
          </div>
        </div>
      </section>

      <div class="grid">
        <div class="instrument-card">
          <h3>Instrumen Dikirim Final</h3>
          <div class="metric"><%= completedCount %>/6</div>
          <p style="min-height:0;text-align:center">Jumlah instrumen dengan status selesai.</p>
        </div>
        <div class="instrument-card">
          <h3>Progres Total Kecamatan</h3>
          <div class="metric"><%= overallProgress %>%</div>
          <div class="progress"><div class="bar" style="width:<%= overallProgress %>%"><%= overallProgress %>%</div></div>
          <p style="min-height:0;text-align:center"><%= overallProgressDetail.completed %> dari <%= overallProgressDetail.total %> unsur isian dan bukti.</p>
        </div>
      </div>

      <div class="grid">
        <% const borderColors = ['#5d73df','#7047a5','#27975a','#d49a00','#16859d','#e36b1c']; %>
        <% instruments.forEach((item,index) => { const statusClass = item.status === 'Sudah' ? 'sudah' : (item.status === 'Draft' ? 'draft' : 'belum'); %>
          <article class="instrument-card" style="border-left-color:<%= borderColors[index] %>">
            <h3>Instrumen <%= item.key %> — <%= item.title %></h3>
            <p><%= item.description %></p>
            <div class="progress"><div class="bar" style="width:<%= item.progress.percent %>%"><%= item.progress.percent %>%</div></div>
            <div class="progress-meta">
              <div><strong>Skor:</strong> <%= item.totalScore %>/<%= item.maxScore %></div>
              <div><strong>Isian:</strong> <%= item.progress.dataFilled %>/<%= item.progress.dataTotal %> (<%= item.progress.dataPercent %>%)</div>
              <div><strong>Bukti:</strong> <%= item.progress.evidenceFilled %>/<%= item.progress.evidenceTotal %> (<%= item.progress.evidencePercent %>%)</div>
            </div>
            <a href="<%= item.url %>" class="btn">Buka Instrumen</a>
            <span class="badge badge-<%= statusClass %>"><%= item.status %></span>
            <% const reviewClass = item.reviewStatus === 'Terverifikasi' ? 'verified' : (item.reviewStatus === 'Perlu Perbaikan' ? 'revision' : 'pending'); %>
            <span class="badge badge-<%= reviewClass %>"><%= item.reviewStatus %></span>
            <% if (item.reviewNotes) { %><div class="evaluation-note"><strong>Catatan evaluator:</strong> <%= item.reviewNotes %></div><% } %>
          </article>
        <% }) %>
      </div>

      <script>
        const deadlineTime = new Date('<%= deadline %>T23:59:59').getTime();
        const countdown = document.getElementById('countdown');
        function updateCountdown() {
          const distance = deadlineTime - Date.now();
          if (distance <= 0) { countdown.textContent = 'Batas waktu telah berakhir — pengisian dan upload dikunci'; return; }
          const days = Math.floor(distance / 86400000);
          const hours = Math.floor((distance % 86400000) / 3600000);
          const minutes = Math.floor((distance % 3600000) / 60000);
          const seconds = Math.floor((distance % 60000) / 1000);
          countdown.textContent = `${days} hari ${hours} jam ${minutes} menit ${seconds} detik`;
        }
        updateCountdown(); setInterval(updateCountdown,1000);
      </script>
    <% } else { %>
      <% const totalKecamatan = kecamatans.length; %>
      <% const mulai = kecamatans.filter(item => item.progress_percent > 0).length; %>
      <% const rata = totalKecamatan ? Math.round(kecamatans.reduce((sum,item)=>sum+item.progress_percent,0)/totalKecamatan) : 0; %>
      <div class="grid">
        <div class="instrument-card"><h3>Kecamatan Mulai Mengisi</h3><div class="metric"><%= mulai %>/<%= totalKecamatan %></div><p style="min-height:0;text-align:center">Berdasarkan progres numerik, bukan status final.</p></div>
        <div class="instrument-card"><h3>Rata-rata Progres Kabupaten</h3><div class="metric"><%= rata %>%</div><div class="progress"><div class="bar" style="width:<%= rata %>%"><%= rata %>%</div></div></div>
        <div class="instrument-card"><h3>Batas Waktu Aktif</h3><div class="metric" style="font-size:27px"><%= deadline %></div><p style="min-height:0;text-align:center"><a class="btn" href="/admin/settings">Ubah Batas Waktu</a></p></div>
      </div>

      <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
        <%
          const totalUploadedVerified = kecamatans.reduce((sum,item)=>sum+(item.uploaded_verified_instruments || 0),0);
          const totalUploadedUnverified = kecamatans.reduce((sum,item)=>sum+(item.uploaded_unverified_instruments || 0),0);
        %>
        <section class="card">
          <h2>Grafik Capaian Kecamatan Berdasarkan Upload Data</h2>
          <p class="muted">Grafik ini menampilkan persentase capaian pengisian berbasis upload data per kecamatan. Angka persentase ditampilkan di atas setiap batang seperti dashboard Excel.</p>
          <div class="grid" style="margin-top:14px">
            <div class="instrument-card"><h3>Upload Sudah Diverifikasi</h3><div class="metric"><%= totalUploadedVerified %></div><p style="min-height:0;text-align:center">Total instrumen berstatus upload final dan terverifikasi.</p></div>
            <div class="instrument-card"><h3>Upload Belum Diverifikasi</h3><div class="metric"><%= totalUploadedUnverified %></div><p style="min-height:0;text-align:center">Total instrumen berstatus upload final tetapi belum terverifikasi.</p></div>
            <div class="instrument-card"><h3>Rata-rata Capaian</h3><div class="metric"><%= rata %>%</div><p style="min-height:0;text-align:center">Rata-rata progres upload data seluruh kecamatan.</p></div>
          </div>
          <canvas id="uploadVerificationChart" height="140"></canvas>
          <div style="height:22px"></div>
          <h3 style="font-size:15px;color:#273142;margin-bottom:8px">Grafik Status Verifikasi Upload</h3>
          <p class="muted" style="margin-bottom:10px">Grafik ini tetap menampilkan jumlah upload yang sudah diverifikasi dan belum diverifikasi.</p>
          <canvas id="uploadVerificationStatusChart" height="90"></canvas>
        </section>
      <% } %>

      <section class="card">
        <h2>Rata-rata Progres per Instrumen</h2>
        <canvas id="progressChart" height="95"></canvas>
      </section>

      <section class="table-card">
        <h2>Progres Setiap Kecamatan per Instrumen</h2>
        <p class="muted">Angka pada setiap instrumen merupakan gabungan kelengkapan isian dan bukti dukung.</p>
        <table>
          <thead><tr><th>No.</th><th>Kecamatan</th><th>Pengelola</th><th>Instrumen A</th><th>Instrumen B</th><th>Instrumen C</th><th>Instrumen D</th><th>Instrumen E</th><th>Instrumen F</th><th>Total</th><th>Baseline Excel</th><th>Evaluasi</th><th>Aksi</th></tr></thead>
          <tbody>
            <% kecamatans.forEach((kc,index) => { %>
              <tr>
                <td><%= index+1 %></td>
                <td><strong><%= kc.nama %></strong><div class="subtle"><%= kc.email || 'Email belum diisi' %></div></td>
                <td><%= kc.nama_pengelola || '-' %></td>
                <% ['a','b','c','d','e','f'].forEach(code => { %>
                  <td>
                    <div class="mini-progress"><div class="progress"><div class="bar" style="width:<%= kc['progress_'+code] %>%"><%= kc['progress_'+code] %>%</div></div></div>
                    <div class="subtle">Isian <%= kc['data_progress_'+code] %>% · Bukti <%= kc['evidence_progress_'+code] %>%</div>
                  </td>
                <% }) %>
                <td><strong><%= kc.progress_percent %>%</strong></td>
                <td>
                  <% if (kc.workbook_score !== null) { %>
                    <strong><%= kc.workbook_score %>/100</strong>
                    <% if (kc.workbook_ranking !== null && kc.workbook_ranking !== undefined) { %><div class="subtle">Peringkat <%= kc.workbook_ranking %></div><% } %>
                    <div class="subtle"><%= kc.workbook_source || 'Workbook impor' %></div>
                  <% } else { %>
                    <span class="subtle">Belum diimpor</span>
                  <% } %>
                </td>
                <td><strong><%= kc.verified_instruments %>/6</strong> terverifikasi<div class="subtle"><%= kc.evaluation_status %><% if (kc.final_score !== null) { %> · <%= kc.final_score %>/<%= 100 %><% } %></div></td>
                <td><a class="btn" href="/evaluation/<%= kc.id %>">Evaluasi</a> <a class="btn btn-secondary" href="/assessment/scoring?kecamatan_id=<%= kc.id %>">Skor</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="legend">Status final tetap disimpan sebagai Draft, Belum Lengkap, atau Sudah. Persentase pada tabel digunakan untuk memantau proses pengisian secara nyata.</div>
      </section>

      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script>
        const kecamatanProgressData = <%- JSON.stringify(kecamatans.map(k => ({a:k.progress_a,b:k.progress_b,c:k.progress_c,d:k.progress_d,e:k.progress_e,f:k.progress_f}))) %>;
        const averages = ['a','b','c','d','e','f'].map(code => {
          const values = kecamatanProgressData.map(item => item[code] || 0);
          return values.length ? Math.round(values.reduce((a,b)=>a+b,0)/values.length) : 0;
        });
        new Chart(document.getElementById('progressChart'), {
          type:'bar',
          data:{ labels:['A — Pelayanan Publik','B — Pemerintahan Umum','C — Anggaran','D — Inovasi','E — Sumber Daya Manusia','F — Data Dukung'], datasets:[{ data:averages, backgroundColor:['#5d73df','#7047a5','#27975a','#d49a00','#16859d','#e36b1c'] }] },
          options:{ responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,max:100,title:{display:true,text:'Progres (%)'}}} }
        });

        const valueLabelPlugin = {
          id: 'valueLabelPlugin',
          afterDatasetsDraw(chart) {
            const { ctx } = chart;
            chart.data.datasets.forEach((dataset, datasetIndex) => {
              const meta = chart.getDatasetMeta(datasetIndex);
              if (meta.hidden) return;
              meta.data.forEach((bar, index) => {
                const raw = Number(dataset.data[index] || 0);
                ctx.save();
                ctx.fillStyle = '#273142';
                ctx.font = 'bold 11px Segoe UI';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'bottom';
                ctx.fillText(`${raw}%`, bar.x, bar.y - 4);
                ctx.restore();
              });
            });
          }
        };

        const uploadChartElement = document.getElementById('uploadVerificationChart');
        const uploadVerificationData = <%- JSON.stringify(kecamatans.map(k => ({
          nama: k.nama,
          percent: k.progress_percent || 0,
          verified: k.uploaded_verified_instruments || 0,
          unverified: k.uploaded_unverified_instruments || 0
        }))) %>;

        const topFiveNames = new Set(
          [...uploadVerificationData]
            .sort((a, b) => Number(b.percent || 0) - Number(a.percent || 0))
            .slice(0, 5)
            .map(item => item.nama)
        );

        const topFiveColors = ['#d49a00', '#7047a5', '#e36b1c', '#16859d', '#5d73df'];
        const topFiveColorMap = new Map(
          [...uploadVerificationData]
            .sort((a, b) => Number(b.percent || 0) - Number(a.percent || 0))
            .slice(0, 5)
            .map((item, index) => [item.nama, topFiveColors[index] || '#d49a00'])
        );

        if (uploadChartElement) {
          new Chart(uploadChartElement, {
            type:'bar',
            data:{
              labels: uploadVerificationData.map(item => item.nama),
              datasets:[
                {
                  label:'Capaian Upload Data (%)',
                  data: uploadVerificationData.map(item => item.percent),
                  backgroundColor: uploadVerificationData.map(item => topFiveColorMap.get(item.nama) || '#22a447'),
                  borderColor: uploadVerificationData.map(item => topFiveNames.has(item.nama) ? '#273142' : '#1c8b39'),
                  borderWidth: uploadVerificationData.map(item => topFiveNames.has(item.nama) ? 2 : 1)
                }
              ]
            },
            options:{
              responsive:true,
              plugins:{
                legend:{position:'bottom'},
                tooltip:{
                  callbacks:{
                    label(context) {
                      const data = uploadVerificationData[context.dataIndex] || {};
                      const topLabel = topFiveNames.has(data.nama) ? 'TOP 5 - ' : '';
                      return [
                        `${topLabel}Capaian: ${Number(context.raw || 0)}%`,
                        `Sudah diverifikasi: ${data.verified || 0} instrumen`,
                        `Belum diverifikasi: ${data.unverified || 0} instrumen`
                      ];
                    }
                  }
                }
              },
              scales:{
                x:{ticks:{autoSkip:false,maxRotation:60,minRotation:30}},
                y:{beginAtZero:true,max:100,ticks:{stepSize:10},title:{display:true,text:'Persentase capaian (%)'}}
              }
            },
            plugins:[valueLabelPlugin]
          });
        }

        const uploadStatusChartElement = document.getElementById('uploadVerificationStatusChart');
        if (uploadStatusChartElement) {
          new Chart(uploadStatusChartElement, {
            type:'bar',
            data:{
              labels: uploadVerificationData.map(item => item.nama),
              datasets:[
                { label:'Sudah Diverifikasi', data:uploadVerificationData.map(item => item.verified), backgroundColor:'#22a447' },
                { label:'Belum Diverifikasi', data:uploadVerificationData.map(item => item.unverified), backgroundColor:'#efb400' },
                {
                  label:'Belum Upload Final',
                  data: uploadVerificationData.map(item => Math.max(0, 6 - Number(item.verified || 0) - Number(item.unverified || 0))),
                  backgroundColor:'#d9dde8'
                }
              ]
            },
            options:{
              responsive:true,
              plugins:{
                legend:{position:'bottom'},
                tooltip:{
                  callbacks:{
                    footer(context) {
                      const data = uploadVerificationData[context[0].dataIndex] || {};
                      const empty = Math.max(0, 6 - Number(data.verified || 0) - Number(data.unverified || 0));
                      return `Total instrumen: 6 | Belum upload final: ${empty}`;
                    }
                  }
                }
              },
              scales:{
                x:{stacked:true,ticks:{autoSkip:false,maxRotation:60,minRotation:30}},
                y:{stacked:true,beginAtZero:true,max:6,ticks:{stepSize:1},title:{display:true,text:'Jumlah upload instrumen'}}
              }
            }
          });
        }
      </script>
    <% } %>
  </main>
</body>
</html>
