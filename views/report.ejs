<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Laporan Progres Pengisian SIESELON</title>
  <style>
    *{box-sizing:border-box} body{font-family:"Segoe UI",Arial,sans-serif;background:#f4f6fb;margin:0;color:#273142}.nav{background:#5d73df;color:#fff;padding:14px 24px;display:flex;justify-content:space-between;align-items:center}.nav a{color:#fff;text-decoration:none;background:rgba(255,255,255,.18);padding:8px 12px;border-radius:6px;margin-left:6px}.container{max-width:1500px;margin:25px auto;padding:0 16px}.card{background:#fff;padding:24px;border-radius:12px;box-shadow:0 3px 14px rgba(25,42,70,.08);overflow-x:auto}h2{margin-top:0}p{color:#677286}table{border-collapse:collapse;width:100%;min-width:1100px;margin-top:18px}th,td{padding:10px;border:1px solid #dde2ec;font-size:12px;text-align:center;vertical-align:middle}th{background:#5d73df;color:#fff}td:nth-child(2),td:nth-child(3){text-align:left}.progress{height:18px;background:#e7eaf1;border-radius:999px;overflow:hidden;min-width:78px}.bar{height:100%;background:linear-gradient(90deg,#5d73df,#7047a5);color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center}.small{font-size:10px;color:#7b8495;margin-top:3px}.note{margin-top:16px;padding:12px;background:#f7f8fc;border-left:4px solid #5d73df;border-radius:6px;font-size:12px;color:#566174}@media print{.nav{display:none}.container{margin:0;max-width:none}.card{box-shadow:none;padding:0}th,td{font-size:9px;padding:5px}}
  </style>
</head>
<body>
  <div class="nav"><strong>📋 Laporan Progres Pengisian SIESELON</strong><div><a href="/dashboard">Kembali</a><a href="javascript:window.print()">Cetak</a></div></div>
  <main class="container">
    <section class="card">
      <h2>Progres Pengisian Instrumen A–F per Kecamatan</h2>
      <p>Kabupaten Sumedang — Kegiatan Tahun 2026</p>
      <table>
        <thead><tr><th>No.</th><th>Kecamatan</th><th>Pengelola</th><th>A</th><th>B</th><th>C</th><th>D</th><th>E</th><th>F</th><th>Progres Total</th></tr></thead>
        <tbody>
          <% if (!kecamatans || kecamatans.length === 0) { %>
            <tr><td colspan="10">Belum ada data kecamatan.</td></tr>
          <% } %>
          <% (kecamatans || []).forEach((kc,index) => { %>
            <tr>
              <td><%= index+1 %></td><td><strong><%= kc.nama %></strong></td><td><%= kc.nama_pengelola || '-' %></td>
              <% ['a','b','c','d','e','f'].forEach(code => { %>
                <td><div class="progress"><div class="bar" style="width:<%= kc['progress_'+code] %>%"><%= kc['progress_'+code] %>%</div></div><div class="small">Isian <%= kc['data_progress_'+code] %>% · Bukti <%= kc['evidence_progress_'+code] %>%</div></td>
              <% }) %>
              <td><strong><%= kc.progress_percent %>%</strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="note"><strong>Keterangan:</strong> progres merupakan gabungan kelengkapan isian dan bukti dukung. Progres pengisian tidak sama dengan skor kinerja.</div>
    </section>
  </main>
</body>
</html>
