<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#245b8a">
  <title>Login — SI ESELON Kabupaten Sumedang</title>
  <style>
    :root{
      --panel:#2b6292;
      --panel-dark:#174c78;
      --panel-edge:#0e466f;
      --white:#fff;
      --gold:#ffd447;
      --muted:#dcecf8;
      --danger:#ffd9d7;
      --danger-text:#8f2020;
      --success:#d9f4df;
      --success-text:#155c35;
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%}
    body{
      min-height:100vh;
      font-family:"Segoe UI",Arial,sans-serif;
      color:var(--white);
      background:#3e765d url("/images/sumedang-lkpj-slide-clean.png") center/100% 100% no-repeat fixed;
      overflow-x:hidden;
    }
    .page{
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      padding:110px 24px 76px;
      position:relative;
    }
    .login-panel{
      width:min(760px,54vw);
      padding:27px 40px 29px;
      background:#285d8d;
      border:2px solid #0d466f;
      box-shadow:
        0 0 0 8px #2e6798,
        0 0 0 10px rgba(12,64,101,.78),
        0 12px 26px rgba(0,31,52,.28),
        inset 0 1px 0 rgba(255,255,255,.12);
    }
    .brand{text-align:center;margin-bottom:19px}
    .brand h1{
      margin:0;
      font-size:clamp(29px,2.8vw,40px);
      font-weight:900;
      line-height:1;
      letter-spacing:.12em;
      text-shadow:0 3px 0 rgba(10,54,88,.8);
    }
    .brand h1 span{color:var(--gold)}
    .brand p{
      margin:8px auto 0;
      max-width:590px;
      color:var(--muted);
      font-size:11px;
      line-height:1.45;
      letter-spacing:.025em;
    }
    .separator{
      width:76px;height:3px;margin:12px auto 0;
      border-radius:10px;
      background:linear-gradient(90deg,transparent,var(--gold),transparent);
    }
    .alert{
      padding:10px 13px;
      margin:0 0 14px;
      border-radius:7px;
      font-size:13px;
      text-align:center;
      border:1px solid rgba(255,255,255,.45);
    }
    .alert-error{background:var(--danger);color:var(--danger-text)}
    .alert-success{background:var(--success);color:var(--success-text)}
    .form-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:17px;
    }
    .form-group{min-width:0}
    label{
      display:block;
      margin-bottom:7px;
      font-size:12px;
      font-weight:800;
      letter-spacing:.04em;
      text-transform:uppercase;
    }
    .input-wrap{position:relative}
    .input-icon{
      position:absolute;
      left:13px;top:50%;
      width:18px;height:18px;
      transform:translateY(-50%);
      color:#57758d;
      pointer-events:none;
    }
    input[type="text"],input[type="password"]{
      width:100%;
      height:44px;
      padding:0 44px 0 42px;
      border:2px solid #c8d7e3;
      border-radius:7px;
      color:#173c58;
      background:#fff;
      font-size:14px;
      box-shadow:inset 0 2px 4px rgba(15,61,96,.08);
      transition:border-color .2s,box-shadow .2s;
    }
    input::placeholder{color:#8496a4}
    input:focus{
      outline:none;
      border-color:var(--gold);
      box-shadow:0 0 0 4px rgba(255,212,71,.2);
    }
    .password-toggle{
      position:absolute;right:7px;top:50%;
      transform:translateY(-50%);
      width:34px;height:34px;
      border:0;border-radius:6px;
      background:transparent;
      color:#57758d;
      cursor:pointer;
      font-size:17px;
    }
    .password-toggle:hover{background:#e9f0f5}
    .btn-login{
      width:100%;
      height:45px;
      margin-top:16px;
      border:2px solid #f1c927;
      border-radius:7px;
      color:#173b56;
      background:linear-gradient(#ffe679,#f3c52d);
      font-size:15px;
      font-weight:900;
      letter-spacing:.045em;
      cursor:pointer;
      box-shadow:0 5px 0 #b68512,0 9px 18px rgba(7,40,64,.27);
      transition:transform .16s,filter .16s,box-shadow .16s;
    }
    .btn-login:hover{filter:brightness(1.06);transform:translateY(-1px)}
    .btn-login:active{transform:translateY(3px);box-shadow:0 2px 0 #b68512}
    .security{
      margin:17px 0 0;
      text-align:center;
      color:#d4e6f3;
      font-size:11px;
      line-height:1.5;
    }
    .security strong{color:#fff}
    .mobile-title{display:none}
    @media(max-width:860px){
      body{
        background-position:center;
        background-size:auto 100%;
        background-attachment:scroll;
      }
      .page{padding:105px 18px 62px}
      .login-panel{width:min(88vw,650px);padding:27px 30px 29px}
    }
    @media(max-width:620px){
      body{
        background:
          linear-gradient(rgba(30,85,115,.08),rgba(39,103,73,.18)),
          url("/images/sumedang-lkpj-slide-clean.png") center/auto 100% no-repeat,
          #4f8b62;
      }
      .page{padding:105px 16px 45px}
      .login-panel{
        width:100%;
        min-height:0;
        padding:25px 21px 28px;
        box-shadow:
          0 0 0 7px rgba(35,87,132,.96),
          0 0 0 9px rgba(15,70,111,.55),
          0 15px 32px rgba(0,31,52,.35);
      }
      .brand h1{font-size:29px}
      .brand p{font-size:11px}
      .form-grid{grid-template-columns:1fr;gap:14px}
      .security{font-size:10px}
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="login-panel" aria-labelledby="loginTitle">
      <header class="brand">
        <h1 id="loginTitle">SI <span>ESELON</span></h1>
        <p>Sistem Informasi Evaluasi Sinergitas Kinerja dan Laporan Kecamatan<br>Kabupaten Sumedang — Tahun 2026</p>
        <div class="separator" aria-hidden="true"></div>
      </header>

      <% if (error) { %>
        <div class="alert alert-error" role="alert">⚠️ <%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success" role="status">✓ <%= success %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-grid">
          <div class="form-group">
            <label for="username">Username</label>
            <div class="input-wrap">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <input type="text" id="username" name="username" placeholder="Masukkan username" autocomplete="username" required autofocus>
            </div>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-wrap">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 10V7a5 5 0 0 1 10 0v3M5 10h14v11H5V10Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <input type="password" id="password" name="password" placeholder="Masukkan password" autocomplete="current-password" required>
              <button class="password-toggle" type="button" id="passwordToggle" aria-label="Tampilkan password" title="Tampilkan password">◉</button>
            </div>
          </div>
        </div>

        <button type="submit" class="btn-login">MASUK KE SI ESELON</button>
      </form>

      <p class="security"><strong>Akses Resmi Pemerintah Kabupaten Sumedang</strong><br>Gunakan akun yang diberikan administrator dan jaga kerahasiaan password Anda.</p>
    </section>
  </main>

  <script>
    (function(){
      const button=document.getElementById('passwordToggle');
      const input=document.getElementById('password');
      if(!button||!input)return;
      button.addEventListener('click',function(){
        const visible=input.type==='text';
        input.type=visible?'password':'text';
        button.textContent=visible?'◉':'◌';
        button.setAttribute('aria-label',visible?'Tampilkan password':'Sembunyikan password');
        button.setAttribute('title',visible?'Tampilkan password':'Sembunyikan password');
        input.focus();
      });
    })();
  </script>
</body>
</html>
