<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ubah Password - SIESELON</title>
  <style>
    *{box-sizing:border-box}body{margin:0;font-family:"Segoe UI",Arial,sans-serif;background:#f4f6fb;color:#273142}
    .nav{background:linear-gradient(135deg,#5d73df,#7047a5);color:#fff;padding:14px 24px;display:flex;justify-content:space-between}
    .nav a{color:#fff;text-decoration:none;background:rgba(255,255,255,.18);padding:8px 12px;border-radius:7px}
    .card{max-width:560px;margin:48px auto;background:#fff;padding:28px;border-radius:14px;box-shadow:0 4px 20px rgba(25,42,70,.1)}
    h1{margin-top:0}.muted{color:#687386;line-height:1.55}.field{margin:18px 0}label{display:block;font-weight:700;margin-bottom:7px}
    input{width:100%;padding:12px;border:1px solid #cfd5e1;border-radius:8px;font-size:15px}
    button{border:0;border-radius:8px;padding:11px 18px;color:#fff;background:#5d73df;font-weight:700;cursor:pointer}
    .message{padding:12px;border-radius:8px;margin:14px 0}.success{background:#d7f2df;color:#166534}.error{background:#f9d9df;color:#922b3e}
  </style>
</head>
<body>
  <div class="nav"><strong>SIESELON — Keamanan Akun</strong><a href="/dashboard">Kembali</a></div>
  <main class="card">
    <h1>Ubah Password</h1>
    <p class="muted">Gunakan minimal 6 karakter yang memuat huruf dan angka. Jangan gunakan nama kecamatan sebagai password.</p>
    <% if (success) { %><div class="message success"><%= success %></div><% } %>
    <% if (error) { %><div class="message error"><%= error %></div><% } %>
    <form method="POST" action="/account/password">
      <div class="field"><label>Password saat ini</label><input type="password" name="current_password" required></div>
      <div class="field"><label>Password baru</label><input type="password" name="new_password" minlength="6" required></div>
      <div class="field"><label>Konfirmasi password baru</label><input type="password" name="confirm_password" minlength="6" required></div>
      <button type="submit">Simpan Password</button>
    </form>
  </main>
</body>
</html>
