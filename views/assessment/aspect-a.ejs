<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Instrumen A — Pelayanan Publik</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:"Segoe UI",Tahoma,sans-serif;background:#f4f6fb;padding:18px;color:#273142}
    .container{max-width:1120px;margin:auto}
    .header{background:linear-gradient(135deg,#5d73df,#7047a5);color:#fff;padding:24px;border-radius:12px;text-align:center;margin-bottom:18px}
    .header h1{font-size:23px;margin-bottom:7px}
    .form{background:#fff;padding:24px;border-radius:12px;box-shadow:0 3px 14px rgba(25,42,70,.08)}
    .indicator{background:#f8f9fc;border-left:5px solid #5d73df;padding:17px;border-radius:9px;margin-bottom:15px}
    .indicator h3{font-size:15px;line-height:1.5;margin-bottom:10px}
    .fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}
    .field{background:#fff;padding:11px;border-radius:7px;border:1px solid #e5e9f0}
    .field label{display:block;font-size:13px;font-weight:600;line-height:1.45;margin-bottom:6px}
    .field input,.field select{width:100%;padding:9px;border:1px solid #cfd5df;border-radius:6px;font-size:13px}
    .note{background:#eef1ff;color:#4b5680;padding:9px 11px;border-radius:7px;font-size:12px;line-height:1.5;margin-bottom:10px}
    .btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}
    .btn{border:0;border-radius:7px;padding:11px 20px;font-weight:700;text-decoration:none;cursor:pointer}
    .primary{background:linear-gradient(135deg,#5d73df,#7047a5);color:#fff}
    .draft{background:#f0b90b;color:#222}
    .secondary{background:#667085;color:#fff}
  </style>
</head>
<body>
<div class="container">
  <header class="header">
    <h1>Instrumen A — Pelayanan Publik</h1>
    <p>Kecamatan <%= kecamatan %> · 16 indikator · 32 unsur bukti dukung</p>
  </header>

  <%- include('_progress-summary', { progress }) %>
  <%- include('_standards-panel', { standard }) %>
  <%- include('_file-panel', { instrument:'a', data, uploadedFiles, missingEvidenceKeys, saved, saveResult, kecamatan_id, isAdmin }) %>

  <div class="form">
    <%
      // Kompatibel dengan project lama yang belum memakai middleware CSRF
      // dan project produksi yang sudah menyediakan res.locals.csrfToken.
      const safeCsrfToken = (typeof csrfToken !== 'undefined' && csrfToken)
        ? String(csrfToken)
        : '';
      const formQuery = [];
      if (kecamatan_id) formQuery.push('kecamatan_id=' + encodeURIComponent(kecamatan_id));
      if (safeCsrfToken) formQuery.push('_csrf=' + encodeURIComponent(safeCsrfToken));
      const formAction = '/assessment/instrument-a' + (formQuery.length ? '?' + formQuery.join('&') : '');
    %>
    <form action="<%= formAction %>" method="POST" enctype="multipart/form-data">
      <% if (safeCsrfToken) { %>
        <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
      <% } %>

      <section class="indicator">
        <h3>1. Kelengkapan data dan potensi kecamatan: Data Monografi Kecamatan</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> peta kecamatan, tabel data penduduk, Buku Profil Kecamatan, data desa atau kelurahan, tabel data Badan Permusyawaratan Desa (BPD), dan tabel data organisasi.</div>
        <div class="field">
          <label>Ketersediaan Data Monografi Kecamatan</label>
          <select name="ind_1_status">
            <option value="">Pilih jawaban</option>
            <option value="ada" <%= data.ind_1_status==='ada'?'selected':'' %>>Ada</option>
            <option value="tidak" <%= data.ind_1_status==='tidak'?'selected':'' %>>Tidak</option>
          </select>
          <%- include('_single-evidence-input',{instrument:'a',indicator:'1',label:'Bukti indikator 1',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>2. Struktur Organisasi Kecamatan</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> dokumen sesuai masing-masing subindikator.</div>
        <div class="fields">
          <% [
            ['a','Peraturan Daerah tentang pembentukan kecamatan','Peraturan Daerah kabupaten atau kota'],
            ['b','Peraturan Kepala Daerah tentang tugas pokok dan fungsi','Peraturan Kepala Daerah tentang tugas pokok dan fungsi'],
            ['c','Bagan Struktur Organisasi dan Tata Kerja (SOTK) Kecamatan','Bagan Struktur Organisasi dan Tata Kerja (SOTK) Kecamatan']
          ].forEach(item => { %>
            <div class="field">
              <label>2.<%= item[0] %>. <%= item[1] %></label>
              <select name="ind_2<%= item[0] %>_status">
                <option value="">Pilih jawaban</option>
                <option value="ada" <%= data['ind_2'+item[0]+'_status']==='ada'?'selected':'' %>>Ada</option>
                <option value="tidak" <%= data['ind_2'+item[0]+'_status']==='tidak'?'selected':'' %>>Tidak</option>
              </select>
              <div class="note" style="margin-top:8px;margin-bottom:0"><strong>Bentuk data dukung:</strong> <%= item[2] %>.</div>
              <%- include('_single-evidence-input',{instrument:'a',indicator:'2'+item[0],label:'Bukti subindikator 2.'+item[0],uploadedFiles,compact:true}) %>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="indicator">
        <h3>3. Peraturan Bupati atau Peraturan Wali Kota tentang pendelegasian sebagian kewenangan kepada Camat</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> dokumen Peraturan Bupati atau Peraturan Wali Kota tentang pendelegasian sebagian kewenangan kepada Camat.</div>
        <div class="field">
          <label>Ketersediaan peraturan pendelegasian sebagian kewenangan kepada Camat</label>
          <select name="ind_3_status">
            <option value="">Pilih jawaban</option>
            <option value="ada" <%= data.ind_3_status==='ada'?'selected':'' %>>Ada</option>
            <option value="tidak" <%= data.ind_3_status==='tidak'?'selected':'' %>>Tidak</option>
          </select>
          <%- include('_single-evidence-input',{instrument:'a',indicator:'3',label:'Bukti indikator 3',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>4. Pelaksanaan urusan pemerintahan yang terkait dengan pelayanan perizinan nonusaha</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> rekapitulasi jumlah urusan pemerintahan yang terkait dengan perizinan nonusaha dan telah dilengkapi dengan instrumen pendukung.</div>
        <div class="field">
          <label>Jumlah urusan pemerintahan yang terkait dengan perizinan nonusaha dan telah dilengkapi dengan instrumen pendukung</label>
          <input type="number" min="0" name="ind_4_jumlah" value="<%= data.ind_4_jumlah ?? '' %>" placeholder="Jumlah urusan">
          <%- include('_single-evidence-input',{instrument:'a',indicator:'4',label:'Bukti indikator 4',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>5. Pelaksanaan urusan pemerintahan yang terkait dengan kewenangan lain yang dilimpahkan</h3>
        <div class="fields">
          <div class="field">
            <label>5.a. Jumlah urusan pemerintahan terkait dengan kewenangan lain yang dilimpahkan dan telah dilengkapi dengan instrumen pendukung</label>
            <input type="number" min="0" name="ind_5a_jumlah" value="<%= data.ind_5a_jumlah ?? '' %>" placeholder="Jumlah urusan">
            <div class="note" style="margin-top:8px;margin-bottom:0"><strong>Bentuk data dukung:</strong> rekapitulasi urusan pemerintahan terkait kewenangan lain yang dilimpahkan dan telah dilengkapi instrumen pendukung.</div>
            <%- include('_single-evidence-input',{instrument:'a',indicator:'5a',label:'Bukti subindikator 5.a',uploadedFiles,compact:true}) %>
          </div>
          <div class="field">
            <label>5.b. Jumlah urusan pemerintahan terkait dengan kewenangan lain yang dilimpahkan dan telah dilaksanakan</label>
            <input type="number" min="0" name="ind_5b_jumlah" value="<%= data.ind_5b_jumlah ?? '' %>" placeholder="Jumlah urusan">
            <div class="note" style="margin-top:8px;margin-bottom:0"><strong>Bentuk data dukung:</strong> rekapitulasi urusan pemerintahan terkait kewenangan lain yang dilimpahkan dan telah dilaksanakan.</div>
            <%- include('_single-evidence-input',{instrument:'a',indicator:'5b',label:'Bukti subindikator 5.b',uploadedFiles,compact:true}) %>
          </div>
        </div>
      </section>

      <section class="indicator">
        <h3>6. Keberadaan Tim Pelimpahan Sebagian Kewenangan Bupati atau Wali Kota kepada Camat</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> dokumen Keputusan Bupati atau Wali Kota tentang Tim Pelimpahan Kewenangan kepada Camat.</div>
        <div class="field">
          <label>Ketersediaan Tim Pelimpahan Sebagian Kewenangan</label>
          <select name="ind_6_status">
            <option value="">Pilih jawaban</option>
            <option value="ada" <%= data.ind_6_status==='ada'?'selected':'' %>>Ada</option>
            <option value="tidak" <%= data.ind_6_status==='tidak'?'selected':'' %>>Tidak</option>
          </select>
          <%- include('_single-evidence-input',{instrument:'a',indicator:'6',label:'Bukti indikator 6',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>7. Ketersediaan pelaporan pelimpahan kewenangan</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> dokumen laporan Camat kepada Bupati atau Wali Kota.</div>
        <div class="field">
          <label>Jumlah laporan pelimpahan kewenangan</label>
          <input type="number" min="0" name="ind_7_jumlah" value="<%= data.ind_7_jumlah ?? '' %>" placeholder="Jumlah laporan">
          <%- include('_single-evidence-input',{instrument:'a',indicator:'7',label:'Bukti indikator 7',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>8. Apakah kecamatan berfungsi sebagai simpul pelayanan terpadu satu pintu atau simpul pelayanan dari perangkat daerah terkait?</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> foto dan dokumen hasil pelayanan terpadu satu pintu.</div>
        <div class="field">
          <label>Fungsi kecamatan sebagai simpul pelayanan</label>
          <select name="ind_8_status">
            <option value="">Pilih jawaban</option>
            <option value="ya" <%= data.ind_8_status==='ya'?'selected':'' %>>Ya</option>
            <option value="tidak" <%= data.ind_8_status==='tidak'?'selected':'' %>>Tidak</option>
          </select>
          <%- include('_single-evidence-input',{instrument:'a',indicator:'8',label:'Bukti indikator 8',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>9. Jumlah pelaksana teknis pelayanan</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> fotokopi Keputusan Camat tentang penetapan pelaksana teknis pelayanan publik di kecamatan untuk setiap unsur pelaksana.</div>
        <div class="fields">
          <% [
            ['a','Petugas loket atau penerima berkas'],
            ['b','Petugas informasi'],
            ['c','Petugas operator komputer'],
            ['d','Petugas khusus unit pengaduan'],
            ['e','Petugas keamanan']
          ].forEach(item => { %>
            <div class="field">
              <label>9.<%= item[0] %>. <%= item[1] %></label>
              <select name="ind_9<%= item[0] %>_status">
                <option value="">Pilih jawaban</option>
                <option value="ada" <%= data['ind_9'+item[0]+'_status']==='ada'?'selected':'' %>>Ada</option>
                <option value="tidak" <%= data['ind_9'+item[0]+'_status']==='tidak'?'selected':'' %>>Tidak</option>
              </select>
              <%- include('_single-evidence-input',{instrument:'a',indicator:'9'+item[0],label:'Bukti subindikator 9.'+item[0],uploadedFiles,compact:true}) %>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="indicator">
        <h3>10. Keberadaan informasi pelayanan yang diketahui publik</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> foto, dokumentasi, atau tangkapan layar sarana dan prasarana informasi pelayanan untuk setiap subindikator.</div>
        <div class="fields">
          <% [
            ['a','Informasi bagan alur pelayanan'],
            ['b','Motto pelayanan'],
            ['c','Standar Operasional Prosedur (SOP) pelayanan'],
            ['d','Maklumat pelayanan'],
            ['e','Leaflet, brosur, atau jenis informasi lainnya terkait jenis dan profil pelayanan'],
            ['f','Loket khusus lansia dan penyandang disabilitas'],
            ['g','Situs web kecamatan dan media sosial lainnya']
          ].forEach(item => { %>
            <div class="field">
              <label>10.<%= item[0] %>. <%= item[1] %></label>
              <select name="ind_10<%= item[0] %>_status">
                <option value="">Pilih jawaban</option>
                <option value="ada" <%= data['ind_10'+item[0]+'_status']==='ada'?'selected':'' %>>Ada</option>
                <option value="tidak" <%= data['ind_10'+item[0]+'_status']==='tidak'?'selected':'' %>>Tidak</option>
              </select>
              <%- include('_single-evidence-input',{instrument:'a',indicator:'10'+item[0],label:'Bukti subindikator 10.'+item[0],uploadedFiles,compact:true}) %>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="indicator">
        <h3>11. Tingkat kepuasan masyarakat terhadap pelayanan di kecamatan</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> laporan atau rekapitulasi survei kepuasan masyarakat.</div>
        <div class="field">
          <label>Hasil penilaian tingkat kepuasan masyarakat</label>
          <select name="ind_11_status">
            <option value="">Pilih hasil penilaian</option>
            <% ['Sangat Baik','Baik','Kurang Baik','Tidak Baik','Tidak Ada Data'].forEach(option => { %>
              <option value="<%= option %>" <%= data.ind_11_status===option?'selected':'' %>><%= option %></option>
            <% }) %>
          </select>
          <%- include('_single-evidence-input',{instrument:'a',indicator:'11',label:'Bukti indikator 11',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>12. Persentase keluhan atau pengaduan masyarakat yang ditindaklanjuti oleh kecamatan</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> daftar rincian keluhan masyarakat Tahun N-1 dan Tahun N beserta tindak lanjut penyelesaiannya. Tahun N adalah tahun penilaian.</div>
        <div class="fields">
          <div class="field">
            <label>12.a. Jumlah keluhan masyarakat Tahun N yang sudah ditindaklanjuti</label>
            <input type="number" min="0" name="ind_12a_jumlah" value="<%= data.ind_12a_jumlah ?? '' %>" placeholder="Jumlah keluhan">
            <%- include('_single-evidence-input',{instrument:'a',indicator:'12a',label:'Bukti subindikator 12.a',uploadedFiles,compact:true}) %>
          </div>
          <div class="field">
            <label>12.b. Jumlah keluhan masyarakat Tahun N-1</label>
            <input type="number" min="0" name="ind_12b_jumlah" value="<%= data.ind_12b_jumlah ?? '' %>" placeholder="Jumlah keluhan">
            <%- include('_single-evidence-input',{instrument:'a',indicator:'12b',label:'Bukti subindikator 12.b',uploadedFiles,compact:true}) %>
          </div>
        </div>
      </section>

      <section class="indicator">
        <h3>13. Bidang kependudukan dan pencatatan sipil: tersedianya laporan kependudukan</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> laporan perkembangan kependudukan, data pelayanan Kartu Tanda Penduduk Elektronik (KTP-el), Kartu Keluarga, akta kelahiran di tingkat kecamatan, serta foto, rekapitulasi data, atau dokumen hasil kegiatan.</div>
        <div class="field">
          <label>Ketersediaan laporan kependudukan</label>
          <select name="ind_13_status">
            <option value="">Pilih jawaban</option>
            <option value="ada" <%= data.ind_13_status==='ada'?'selected':'' %>>Ada</option>
            <option value="tidak" <%= data.ind_13_status==='tidak'?'selected':'' %>>Tidak</option>
          </select>
          <%- include('_single-evidence-input',{instrument:'a',indicator:'13',label:'Bukti indikator 13',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>14. Penyelenggaraan Sistem Pemerintahan Berbasis Elektronik (SPBE)</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> tangkapan layar fitur masing-masing aplikasi.</div>
        <div class="fields">
          <% [
            ['a','Tersedianya sistem pengaduan masyarakat berbasis elektronik'],
            ['b','Tersedianya administrasi pemerintahan berbasis elektronik'],
            ['c','Sudah menerapkan sistem perkantoran elektronik (e-Office) atau sistem administrasi daring']
          ].forEach(item => { %>
            <div class="field">
              <label>14.<%= item[0] %>. <%= item[1] %></label>
              <select name="ind_14<%= item[0] %>_status">
                <option value="">Pilih jawaban</option>
                <option value="ada" <%= data['ind_14'+item[0]+'_status']==='ada'?'selected':'' %>>Ada</option>
                <option value="tidak" <%= data['ind_14'+item[0]+'_status']==='tidak'?'selected':'' %>>Tidak</option>
              </select>
              <%- include('_single-evidence-input',{instrument:'a',indicator:'14'+item[0],label:'Bukti subindikator 14.'+item[0],uploadedFiles,compact:true}) %>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="indicator">
        <h3>15. Pencapaian target Nomor Induk Berusaha (NIB)</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> rekapitulasi data Nomor Induk Berusaha (NIB).</div>
        <div class="field">
          <label>Persentase pencapaian target Nomor Induk Berusaha (NIB)</label>
          <input type="number" min="0" max="100" step="0.01" name="ind_15_persen" value="<%= data.ind_15_persen ?? '' %>" placeholder="Persentase">
          <%- include('_single-evidence-input',{instrument:'a',indicator:'15',label:'Bukti indikator 15',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <section class="indicator">
        <h3>16. Pencapaian pungutan Pajak Bumi dan Bangunan (PBB)</h3>
        <div class="note"><strong>Bentuk data dukung:</strong> rekapitulasi data Pajak Bumi dan Bangunan (PBB).</div>
        <div class="field">
          <label>Persentase pencapaian pungutan Pajak Bumi dan Bangunan (PBB)</label>
          <input type="number" min="0" max="100" step="0.01" name="ind_16_persen" value="<%= data.ind_16_persen ?? '' %>" placeholder="Persentase">
          <%- include('_single-evidence-input',{instrument:'a',indicator:'16',label:'Bukti indikator 16',uploadedFiles,compact:true}) %>
        </div>
      </section>

      <div class="btns">
        <button class="btn draft" name="save_action" value="draft">💾 Simpan Draft</button>
        <button class="btn primary" name="save_action" value="final">✅ Kirim Final</button>
        <a class="btn secondary" href="/dashboard">Kembali</a>
      </div>
    </form>
  </div>
</div>
</body>
</html>
