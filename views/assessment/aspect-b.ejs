            </div>
          </div>
        </div>

        <!-- Indikator 27-43 (Sisanya) -->
        <div class="indicator-group">
          <h4>27-43. Koordinasi, Prodeskel, BUMDes, dan Lainnya</h4>
          <div class="sub-section">
            <div class="form-row">
              <label>27. Jumlah Koordinasi & Sinkronisasi Perencanaan</label>
              <input type="number" name="ind_27_jumlah" min="0" value="<%= data.ind_27_jumlah || '' %>">
            </div>
            <div class="form-row">
              <label>28. % Desa Batas SIG (Input Persentase)</label>
              <input type="number" name="ind_28_persen" min="0" max="100" value="<%= data.ind_28_persen || '' %>">
            </div>
            <div class="form-row">
              <label>29. % Desa Update Prodeskel</label>
              <input type="number" name="ind_29_persen" min="0" max="100" value="<%= data.ind_29_persen || '' %>">
            </div>
            <div class="form-row">
              <label>30. % Klasifikasi Desa (Swasembada/Swakarsa/Swadaya)</label>
              <input type="number" name="ind_30_persen" min="0" max="100" value="<%= data.ind_30_persen || '' %>">
            </div>
            <div class="form-row">
              <label>31. % Desa RPJMDesa/RKPDesa</label>
              <input type="number" name="ind_31_persen" min="0" max="100" value="<%= data.ind_31_persen || '' %>">
            </div>
            <div class="form-row">
              <label>32. % Desa APBDesa Tepat Waktu</label>
              <input type="number" name="ind_32_persen" min="0" max="100" value="<%= data.ind_32_persen || '' %>">
            </div>
            <div class="form-row">
