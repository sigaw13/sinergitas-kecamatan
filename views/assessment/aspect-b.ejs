              </select>
            </div>
            <div class="form-row">
              <label>10b. Kegiatan Pengurangan Resiko Bencana</label>
              <select name="ind_10b_status">
                <option value="ada" <%= data.ind_10b_status === 'ada' ? 'selected' : '' %>>Ada</option>
                <option value="tidak" <%= data.ind_10b_status === 'tidak' ? 'selected' : '' %>>Tidak</option>
              </select>
            </div>
            <div class="form-row">
