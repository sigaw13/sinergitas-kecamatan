<html lang="id">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Instrumen B — Penyelenggaraan Urusan Pemerintahan Umum</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}body{font-family:"Segoe UI",Tahoma,sans-serif;background:#f4f6fb;padding:18px;color:#273142}.container{max-width:1180px;margin:auto}.header{background:linear-gradient(135deg,#5d73df,#7047a5);color:#fff;padding:24px;border-radius:12px;text-align:center;margin-bottom:18px}.header h1{font-size:23px;margin-bottom:7px}.form-container{background:#fff;padding:24px;border-radius:12px;box-shadow:0 3px 14px rgba(25,42,70,.08)}.indicator{background:#f8f9fc;border-left:5px solid #5d73df;border-radius:9px;padding:17px;margin-bottom:16px}.indicator h3{font-size:15px;line-height:1.45;margin-bottom:10px;color:#273142}.evidence-note{background:#eef1ff;color:#4b5680;padding:9px 11px;border-radius:7px;font-size:12px;line-height:1.45;margin-bottom:10px}.fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px}.field{background:#fff;padding:10px;border-radius:7px}.field label{display:block;font-weight:600;font-size:13px;line-height:1.4;margin-bottom:6px}.field small{display:block;color:#6c7688;font-size:11px;margin-top:5px}.field input,.field select,.field textarea{width:100%;padding:9px;border:1px solid #cfd5df;border-radius:6px;font:inherit;font-size:13px}.field textarea{min-height:80px;resize:vertical}.computed{margin-top:6px;font-size:12px;color:#4f5d73;background:#f4f6fb;padding:7px;border-radius:5px}.btn-group{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}.btn{border:0;border-radius:7px;padding:11px 20px;font-weight:700;text-decoration:none;cursor:pointer}.primary{background:linear-gradient(135deg,#5d73df,#7047a5);color:#fff}.draft{background:#f0b90b;color:#222}.secondary{background:#667085;color:#fff}.file-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:9px}.file-box{background:#edf0f5;padding:10px;border-radius:7px}.file-box.done{background:#d9f1df;border:1px solid #9bd3aa}.badge{display:inline-block;background:#198754;color:#fff;padding:2px 7px;border-radius:999px;font-size:10px;margin-left:5px}.file-box input{width:100%;margin-top:7px}.section-title{font-size:18px;margin:24px 0 12px;color:#4d5ec1;border-bottom:2px solid #e5e8f1;padding-bottom:6px}.range{font-size:11px;color:#687386;margin-top:5px}.category-help{background:#fff7df;border-left:4px solid #e1a800;padding:10px;border-radius:6px;font-size:12px;line-height:1.5;margin-top:8px}
.status-card{background:#fff;padding:14px 18px;border-radius:10px;margin-bottom:16px;border-left:5px solid #5d73df;box-shadow:0 2px 10px rgba(25,42,70,.06)}.status-card strong{color:#3348aa}.status-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;margin-top:10px}.status-metric{background:#f6f8fc;border:1px solid #e2e7f0;border-radius:7px;padding:9px;font-size:12px}.status-metric b{display:block;font-size:18px;color:#4258bf;margin-top:3px}.orphan-warning{background:#fff3cd;color:#735500;border-left:4px solid #d39e00;padding:10px 12px;border-radius:7px;margin-top:10px;font-size:12px;line-height:1.5}.inline-evidence-block{margin-top:12px;padding-top:12px;border-top:1px dashed #c9d2e3}.inline-evidence-title{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:9px;color:#3449ad;font-size:13px;font-weight:700}.inline-evidence-title small{font-weight:600;color:#687386}.inline-evidence-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:9px}.inline-evidence-slot{background:#fff;border:1px solid #d7dee9;border-radius:8px;padding:10px}.inline-evidence-slot.is-complete{background:#effaf2;border-color:#a8d8b2}.inline-evidence-slot-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:5px;font-size:12px}.inline-evidence-status{font-size:9px;font-weight:800;border-radius:999px;padding:3px 7px}.inline-evidence-status.done{background:#198754;color:#fff}.inline-evidence-status.pending{background:#fff1c7;color:#7c5700}.inline-evidence-folder{font-size:10px;color:#687386;line-height:1.35;margin-bottom:7px}.inline-evidence-slot input[type=file]{width:100%;font-size:11px}.inline-evidence-slot small{display:block;color:#687386;font-size:10px;margin-top:5px}.inline-evidence-file{background:#fff;border-radius:6px;padding:7px;font-size:11px;display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:6px}.inline-evidence-file span{overflow-wrap:anywhere}.inline-evidence-actions{display:flex;gap:5px;flex-shrink:0}.inline-evidence-actions a,.inline-evidence-delete{border:0;border-radius:5px;padding:5px 7px;font-size:10px;font-weight:700;text-decoration:none;cursor:pointer}.inline-evidence-actions a{background:#5d73df;color:#fff}.inline-evidence-delete{background:#c0392b;color:#fff}.inline-evidence-locked{font-size:11px;color:#7c5700;background:#fff1c7;padding:7px;border-radius:5px;margin-bottom:6px}@media(max-width:640px){.inline-evidence-grid{grid-template-columns:1fr}.inline-evidence-title{align-items:flex-start;flex-direction:column}}

.question-sequence{display:flex;flex-direction:column;gap:11px}.subquestion-row{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(290px,.75fr);gap:12px;align-items:stretch;background:#fff;border:1px solid #dfe5ef;border-radius:9px;padding:12px}.subquestion-main{min-width:0}.subquestion-main h4{font-size:13px;line-height:1.45;margin-bottom:8px;color:#2f3b52}.subquestion-main .fields{grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}.subquestion-upload{min-width:0}.subquestion-weight{display:inline-block;background:#e8edff;color:#3348aa;border-radius:999px;padding:3px 8px;font-size:10px;font-weight:800;margin-left:6px}.rubric-table{margin-top:10px;border:1px solid #d8dfeb;border-radius:8px;overflow:hidden;background:#fff}.rubric-row{display:grid;grid-template-columns:55px minmax(0,1fr) 90px;border-bottom:1px solid #e5e9f0;font-size:12px}.rubric-row:last-child{border-bottom:0}.rubric-row>span{padding:8px 10px}.rubric-row>span:first-child{font-weight:800;color:#4258bf;background:#f5f7ff;text-align:center}.rubric-row>span:last-child{font-weight:800;text-align:center;background:#f7f9fc}.rubric-row.is-active{background:#ecf8ef}.rubric-row.is-active>span:first-child,.rubric-row.is-active>span:last-child{background:#d8f0df;color:#176b33}.score-preview{margin-top:9px;background:#eef3ff;border-left:4px solid #5d73df;padding:10px;border-radius:6px;font-size:12px;line-height:1.5}.score-preview strong{color:#3348aa}.inline-evidence-block.is-compact{margin:0;padding:0;border-top:0}.inline-evidence-grid.is-compact{grid-template-columns:1fr}.inline-evidence-grid.is-compact .inline-evidence-slot{height:100%}.paired-note{font-size:11px;color:#687386;margin-top:5px}.question-divider{height:1px;background:#e7eaf1;margin:12px 0}.single-upload-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(290px,.75fr);gap:12px;align-items:start}.value-and-category{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.8fr);gap:12px;align-items:start}.category-panel{background:#fbfcff;border:1px solid #dde3ef;border-radius:8px;padding:10px}.category-panel h4{font-size:12px;margin-bottom:7px;color:#3348aa}@media(max-width:860px){.subquestion-row,.single-upload-row,.value-and-category{grid-template-columns:1fr}.subquestion-upload{margin-top:2px}.rubric-row{grid-template-columns:45px minmax(0,1fr) 75px}}
  .choice-options{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px}.choice-option{background:#fff;border:1px solid #d7deea;border-radius:9px;padding:12px;transition:.2s}.choice-option.is-selected{border-color:#5d73df;box-shadow:0 0 0 2px rgba(93,115,223,.12);background:#f5f7ff}.choice-option-head{display:flex;gap:9px;align-items:flex-start;margin-bottom:9px}.choice-option-head input[type=radio]{width:auto;margin-top:3px}.choice-option-label{font-size:13px;font-weight:700;line-height:1.4}.choice-option-score{display:inline-block;margin-top:5px;background:#e8edff;color:#3348aa;border-radius:999px;padding:3px 8px;font-size:11px;font-weight:800}.choice-option .inline-evidence-slot{background:#f8f9fc}.choice-option:not(.is-selected) .inline-evidence-slot{opacity:.62}.choice-option-note{font-size:11px;color:#687386;margin-top:6px}</style>
</head>
<body><div class="container">
  <header class="header"><h1>Instrumen B — Penyelenggaraan Urusan Pemerintahan Umum</h1><p>Kecamatan <%= kecamatan %> · 43 pertanyaan utama · 106 slot bukti resmi</p></header>
  <%- include('_progress-summary', { progress }) %>
  <%- include('_standards-panel', { standard }) %>
  <%
    const bQuestions = (typeof questionDefinitions !== 'undefined' && Array.isArray(questionDefinitions)) ? questionDefinitions : [];
    const bQuestionByNumber = Object.fromEntries(bQuestions.map(question => [Number(question.number), question]));
    const evidenceFor = (number, key) => {
      const question = bQuestionByNumber[Number(number)] || { evidence: [] };
      return (Array.isArray(question.evidence) ? question.evidence : []).filter(item => String(item.key) === String(key));
    };
    const officialEvidenceKeys = new Set(bQuestions.flatMap(question => question.evidence.map(item => String(item.key))));
    const hasLegacyEvidence = key => (uploadedFiles || []).some(file => String(file.indicatorKey || file.indicator_key || '') === String(key));
    const orphanedEvidenceFiles = (uploadedFiles || []).filter(file => !officialEvidenceKeys.has(String(file.indicatorKey || '')));
    const bEvaluationLocked = typeof evaluationLocked !== 'undefined' ? Boolean(evaluationLocked) : false;
    const currentStatus = data && data.upload_status ? data.upload_status : 'Belum';
    const statusLabel = currentStatus === 'Sudah' ? 'Selesai' : currentStatus;
  %>
  <div class="status-card">
    <div><strong>Status Instrumen B</strong> <%= statusLabel %></div>
    <div class="status-grid">
      <div class="status-metric">Isian terisi<b><%= progress.dataFilled %>/<%= progress.dataTotal %></b></div>
      <div class="status-metric">Bukti terunggah<b><%= progress.evidenceFilled %>/<%= progress.evidenceTotal %></b></div>
      <div class="status-metric">Bukti belum lengkap<b><%= missingEvidenceKeys.length %></b></div>
      <div class="status-metric">Skor sistem<b><%= Number(data.total_score || 0).toFixed(2) %>/30</b></div>
    </div>
    <% if (saved && saveResult) { %>
      <div style="margin-top:9px;font-size:12px;color:#166534">Data berhasil disimpan dengan status <strong><%= saveResult.status %></strong>.</div>
    <% } %>
    <% if (orphanedEvidenceFiles.length > 0) { %>
      <div class="orphan-warning">
        <strong><%= orphanedEvidenceFiles.length %> bukti lama masih memakai slot pertanyaan induk.</strong>
        Bukti tersebut tetap disimpan, tetapi belum dianggap sebagai bukti subpertanyaan. Unggah ulang pada slot yang tepat di setiap pertanyaan.
      </div>
    <% } %>
  </div>
  <div class="form-container"><form action="/assessment/instrument-b<%= kecamatan_id ? '?kecamatan_id='+kecamatan_id : '' %>" method="POST" enctype="multipart/form-data">
    <%
      const numberField = (name,label,unit='') => ({type:'number',name,label,unit});
      const selectField = (name,label,options) => ({type:'select',name,label,options});
      const sections = [
        {n:1,title:'Pembinaan Persatuan dan Kesatuan Bangsa: peringatan hari-hari besar nasional di kecamatan',evidence:'Laporan hasil kegiatan dan foto kegiatan.',fields:[numberField('ind_1_jumlah','Jumlah pelaksanaan peringatan hari besar nasional','kali')]},
        {n:2,title:'Pembinaan kerukunan antarsuku dan intrasuku, umat beragama, ras, dan golongan lainnya guna mewujudkan stabilitas keamanan lokal, regional, dan nasional',evidence:'Laporan hasil kegiatan, undangan, daftar hadir, dan foto kegiatan.',fields:[numberField('ind_2_jumlah','Jumlah dialog rutin Camat dengan tokoh masyarakat, tokoh adat, dan tokoh agama','kali')]},

        {n:4,title:'Koordinasi dengan perangkat daerah atau Kepolisian Negara Republik Indonesia terkait penerapan dan penegakan peraturan perundang-undangan',evidence:'Laporan kegiatan, undangan, daftar hadir, foto kegiatan, dan rekapitulasi rekomendasi yang ditindaklanjuti.',fields:[numberField('ind_4a_jumlah','Pertemuan koordinasi Camat, Kepolisian Negara Republik Indonesia (Polri), Tentara Nasional Indonesia (TNI), dan instansi vertikal','kali'),numberField('ind_4b_jumlah','Rekomendasi pertemuan yang ditindaklanjuti','kali')]},
        {n:5,title:'Peningkatan efektivitas kegiatan pemerintahan di tingkat kecamatan',evidence:'Laporan kegiatan, undangan, daftar hadir, foto kegiatan, dan rekomendasi yang ditindaklanjuti.',fields:[numberField('ind_5_jumlah','Jumlah pertemuan rutin antara Camat dan aparatur kecamatan','kali')]},
        {n:6,title:'Persentase permasalahan bidang ketenteraman dan ketertiban yang diselesaikan Camat pada tahun penilaian',evidence:'Rekapitulasi permasalahan, dokumentasi penyelesaian, dan rekomendasi penyelesaian.',fields:[numberField('ind_6_jumlah','Jumlah permasalahan bidang ketenteraman dan ketertiban yang diselesaikan','permasalahan')]},
        {n:7,title:'Koordinasi upaya penyelenggaraan ketenteraman dan ketertiban umum',evidence:'Dokumen rekomendasi hasil penanganan kasus yang ditindaklanjuti.',fields:[numberField('ind_7a_jumlah','Kasus ketenteraman dan ketertiban umum yang dikoordinasikan dengan instansi berwenang','kasus'),numberField('ind_7b_jumlah','Kasus ketenteraman dan ketertiban umum yang dipantau penyelesaiannya oleh kecamatan','kasus')]},
        {n:8,title:'Koordinasi dan sinergi perencanaan serta pelaksanaan kegiatan pemerintahan dengan perangkat daerah dan instansi vertikal terkait',evidence:'Dokumen rekomendasi hasil pertemuan yang ditindaklanjuti.',fields:[numberField('ind_8a_jumlah','Pertemuan koordinasi perencanaan kegiatan pemerintahan','kali'),numberField('ind_8b_jumlah','Laporan hasil koordinasi yang ditindaklanjuti','laporan')]},
        {n:9,title:'Fasilitasi percepatan pencapaian Standar Pelayanan Minimal (SPM) di wilayah kecamatan',evidence:'Laporan kegiatan dan data ketercapaian Standar Pelayanan Minimal (SPM).',fields:[numberField('ind_9a_jumlah','Kegiatan fasilitasi percepatan pencapaian Standar Pelayanan Minimal (SPM)','kali'),numberField('ind_9b_jumlah','Target Standar Pelayanan Minimal (SPM) yang tercapai','pelayanan')]},
        {n:10,title:'Fasilitasi kecamatan dalam rangka penanganan kebencanaan',evidence:'Keputusan Kecamatan Tangguh Bencana dan laporan kegiatan pengurangan risiko bencana.',fields:[selectField('ind_10a_status','Apakah Kecamatan Tangguh Bencana (KENCANA) sudah terbentuk?',[['sudah','Sudah'],['belum','Belum']]),selectField('ind_10b_status','Apakah ada kegiatan yang mendukung pengurangan risiko dan mitigasi bencana?',[['ada','Ada'],['tidak','Tidak']]),selectField('ind_10c_status','Apakah ada kolaborasi dengan pemangku kepentingan untuk peningkatan Standar Pelayanan Minimal (SPM) kebencanaan?',[['ada','Ada'],['tidak','Tidak']])]},
        {n:11,title:'Peningkatan efektivitas pelaksanaan pelayanan kepada masyarakat di wilayah kecamatan',evidence:'Dokumen penyusunan standar pelayanan dan laporan dialog dengan masyarakat.',fields:[numberField('ind_11a_jumlah','Penyusunan standar pelayanan dengan melibatkan perwakilan masyarakat','dokumen'),numberField('ind_11b_jumlah','Dialog dengan masyarakat untuk memantau pelaksanaan standar pelayanan','kali')]},
        {n:12,title:'Harmonisasi hubungan dengan tokoh agama dan tokoh masyarakat',evidence:'Laporan hasil kegiatan dan dokumentasi kegiatan.',fields:[numberField('ind_12a_jumlah','Fasilitasi pembentukan Forum Kerukunan Umat Beragama (FKUB) kecamatan','kali'),numberField('ind_12b_jumlah','Kehadiran Camat atau perangkat kecamatan dalam pertemuan Forum Kerukunan Umat Beragama (FKUB) atau dengan tokoh agama dan tokoh masyarakat','kali')]},
        {n:13,title:'Koordinasi pemeliharaan prasarana dan sarana pelayanan umum',evidence:'Dokumentasi sarana, prasarana, fasilitas umum, dan fasilitas sosial serta laporan koordinasi.',fields:[numberField('ind_13a_jumlah','Sarana, prasarana, fasilitas umum, dan fasilitas sosial rusak atau membutuhkan pemeliharaan','unit atau buah'),numberField('ind_13b_jumlah','Sarana, prasarana, fasilitas umum, dan fasilitas sosial yang dikoordinasikan penanganannya','unit atau buah')]},
        {n:14,title:'Persentase sarana, prasarana, fasilitas umum, dan fasilitas sosial di wilayah kecamatan yang diperbaiki',evidence:'Rekapitulasi dan dokumentasi sarana yang ditemukan rusak, diperbaiki, atau dipelihara.',fields:[numberField('ind_14a_jumlah','Sarana, fasilitas umum, dan fasilitas sosial yang ditemukan atau dilaporkan rusak','unit atau buah'),numberField('ind_14b_jumlah','Sarana, fasilitas umum, dan fasilitas sosial yang diperbaiki oleh dinas terkait','unit atau buah'),numberField('ind_14c_jumlah','Prasarana dan fasilitas pelayanan umum yang dipelihara dengan melibatkan pihak terkait','unit atau buah')]},
        {n:15,title:'Pemberdayaan masyarakat desa dan kelurahan melalui koordinasi kegiatan pemberdayaan',evidence:'Laporan kegiatan, rekapitulasi usulan, dan dokumentasi kegiatan.',fields:[numberField('ind_15a_jumlah','Kegiatan pemberdayaan masyarakat desa yang dilaporkan','kegiatan'),numberField('ind_15b_jumlah','Kegiatan pemberdayaan masyarakat desa yang menunjukkan hasil sesuai rencana','kegiatan'),numberField('ind_15c_jumlah','Kehadiran perwakilan masyarakat dalam Forum Musyawarah Perencanaan Pembangunan (Musrenbang) Desa','kali'),numberField('ind_15d_jumlah','Usulan masyarakat yang diakomodasi sebagai hasil Musyawarah Perencanaan Pembangunan (Musrenbang) Desa','usulan kegiatan')]},
        {n:16,title:'Fasilitasi, rekomendasi, koordinasi, pembinaan, dan pengawasan pemerintahan desa',evidence:'Rekapitulasi peraturan desa, nama desa, rancangan peraturan desa, serta dokumen laporan hasil evaluasi.',fields:[numberField('ind_16a1_jumlah','Desa yang menetapkan Peraturan Desa tentang kewenangan berdasarkan hak asal usul dan kewenangan lokal berskala desa','peraturan desa'),numberField('ind_16a2_jumlah','Desa yang menyusun Laporan Penyelenggaraan Pemerintahan Desa (LPPD Desa)','desa'),numberField('ind_16a3_jumlah','Rancangan Peraturan Desa yang ditetapkan sesuai ketentuan','rancangan peraturan desa'),numberField('ind_16b1_jumlah','Hasil evaluasi rancangan Peraturan Desa terkait Anggaran Pendapatan dan Belanja Desa (APB Desa)','laporan'),numberField('ind_16b2_jumlah','Hasil evaluasi pengelolaan keuangan desa dan aset desa','laporan'),numberField('ind_16b3_jumlah','Hasil evaluasi dokumen laporan pertanggungjawaban Anggaran Pendapatan dan Belanja Desa (APB Desa)','laporan')]},
        {n:17,title:'Fasilitasi administrasi tata pemerintahan desa',evidence:'Rekapitulasi dokumen Profil Desa yang dimutakhirkan.',fields:[numberField('ind_17_jumlah','Desa yang memiliki Profil Desa dan memutakhirkannya secara berkala','desa')]},
        {n:18,title:'Fasilitasi pengelolaan keuangan desa dan pendayagunaan aset desa',evidence:'Rekapitulasi data desa.',fields:[numberField('ind_18a_jumlah','Desa yang memiliki kinerja keuangan baik','desa'),numberField('ind_18b_jumlah','Desa yang melakukan penatausahaan aset desa','desa')]},
        {n:19,title:'Fasilitasi penerapan dan penegakan peraturan perundang-undangan dan Peraturan Daerah',evidence:'Rekapitulasi data kasus.',fields:[numberField('ind_19a_jumlah','Kasus pelanggaran peraturan perundang-undangan yang dikoordinasikan pemerintah desa dengan instansi berwenang','kasus'),numberField('ind_19b_jumlah','Kasus pelanggaran peraturan perundang-undangan yang dipantau penyelesaiannya oleh pemerintah desa','kasus')]},
        {n:20,title:'Fasilitasi pelaksanaan tugas kepala desa dan perangkat desa',evidence:'Rekapitulasi struktur organisasi, Musyawarah Perencanaan Pembangunan Desa, dokumen perencanaan, program pembinaan, dan program pemberdayaan masyarakat.',fields:[numberField('ind_20a_jumlah','Desa yang memiliki struktur organisasi dan tata kerja pemerintahan desa','desa'),numberField('ind_20b_jumlah','Desa yang melaksanakan Musyawarah Perencanaan Pembangunan (Musrenbang) Desa tepat waktu','desa'),numberField('ind_20c_jumlah','Desa yang memiliki dokumen perencanaan dan penganggaran desa','desa'),numberField('ind_20d_jumlah','Desa yang memiliki dan melaksanakan program pembinaan masyarakat desa','desa'),numberField('ind_20e_jumlah','Desa yang memiliki dan melaksanakan program pemberdayaan masyarakat desa','desa')]},
        {n:21,title:'Fasilitasi penetapan lokasi pembangunan kawasan perdesaan',evidence:'Laporan hasil kegiatan dan dokumentasi kegiatan.',fields:[numberField('ind_21_jumlah','Pertemuan koordinasi desa, kecamatan, dan perangkat daerah dalam penetapan lokasi pembangunan kawasan perdesaan','kali')]},
        {n:22,title:'Fasilitasi penyelenggaraan ketenteraman dan ketertiban umum',evidence:'Laporan hasil kegiatan dan dokumentasi kegiatan.',fields:[numberField('ind_22_jumlah','Sosialisasi dan bimbingan teknis kepada pemerintah desa mengenai penyelenggaraan ketenteraman dan ketertiban umum','kali')]},
        {n:23,title:'Fasilitasi pelaksanaan tugas, fungsi, dan kewajiban lembaga kemasyarakatan',evidence:'Laporan, dokumentasi kegiatan, dan rekapitulasi lembaga kemasyarakatan.',fields:[numberField('ind_23a_jumlah','Sosialisasi atau bimbingan teknis kepada pemerintah desa mengenai penyelenggaraan ketenteraman dan ketertiban umum','kali'),numberField('ind_23b_jumlah','Lembaga kemasyarakatan yang aktif melaksanakan tugas dan fungsi','lembaga')]},
        {n:24,title:'Fasilitasi penyusunan perencanaan pembangunan partisipatif',evidence:'Laporan, dokumentasi kegiatan, dan rekapitulasi data desa.',fields:[numberField('ind_24a_jumlah','Sosialisasi atau bimbingan teknis pedoman penyusunan perencanaan pembangunan partisipatif','kali'),numberField('ind_24b_jumlah','Desa yang melaksanakan perencanaan pembangunan partisipatif','desa')]},
