      <div class="question-sequence">
        <% const coopDocs=[
          ['a','Apakah ada naskah kerja sama di kecamatan yang telah dilaksanakan, baik antarpemerintah, perguruan tinggi atau bidang pendidikan, maupun pihak ketiga?'],
          ['b','Apakah ada kerja sama wilayah perbatasan dengan kecamatan berbatasan, baik dalam satu kabupaten maupun kabupaten atau provinsi berbatasan?']
        ]; %>
        <% coopDocs.forEach(item => { %>
          <div class="subquestion-row">
            <div class="subquestion-main">
              <h4>43.<%= item[0] %>. <%= item[1] %></h4>
              <div class="fields">
                <div class="field"><label>Status</label><select name="ind_43<%= item[0] %>_status"><option value="">Pilih...</option><option value="ada" <%= data['ind_43'+item[0]+'_status']==='ada'?'selected':'' %>>Ada</option><option value="tidak" <%= data['ind_43'+item[0]+'_status']==='tidak'?'selected':'' %>>Tidak</option></select></div>
                <div class="field"><label>Jumlah dokumen</label><input type="number" min="0" name="ind_43<%= item[0] %>_jumlah" value="<%= data['ind_43'+item[0]+'_jumlah'] ?? '' %>"><small>Satuan: dokumen</small></div>
              </div>
            </div>
            <div class="subquestion-upload"><%- include('_question-evidence', { question: bQuestionByNumber[43], evidenceItems: evidenceFor(43, 'ind_43'+item[0]), uploadedFiles, evaluationLocked: bEvaluationLocked, compact: true, showTitle: false }) %></div>
          </div>
        <% }) %>
        <div class="subquestion-row">
          <div class="subquestion-main"><h4>43.c. Sebutkan potensi kerja sama di kecamatan</h4><div class="field"><label>Sebutkan potensi kerja sama di kecamatan</label><textarea name="ind_43c_komentar" rows="6"><%= data.ind_43c_komentar ?? '' %></textarea></div></div>
          <div class="subquestion-upload"><%- include('_question-evidence', { question: bQuestionByNumber[43], evidenceItems: evidenceFor(43, 'ind_43c'), uploadedFiles, evaluationLocked: bEvaluationLocked, compact: true, showTitle: false }) %></div>
        </div>
        <div class="subquestion-row">
          <div class="subquestion-main">
            <h4>43.d. Apakah telah dilakukan pemetaan potensi kerja sama?</h4>
            <div class="fields">
              <div class="field"><label>Status</label><select name="ind_43d_status"><option value="">Pilih...</option><option value="ada" <%= data.ind_43d_status==='ada'?'selected':'' %>>Ada</option><option value="tidak" <%= data.ind_43d_status==='tidak'?'selected':'' %>>Tidak</option></select></div>
              <div class="field"><label>Jumlah dokumen</label><input type="number" min="0" name="ind_43d_jumlah" value="<%= data.ind_43d_jumlah ?? '' %>"><small>Satuan: dokumen</small></div>
            </div>
          </div>
          <div class="subquestion-upload"><%- include('_question-evidence', { question: bQuestionByNumber[43], evidenceItems: evidenceFor(43, 'ind_43d'), uploadedFiles, evaluationLocked: bEvaluationLocked, compact: true, showTitle: false }) %></div>
        </div>
        <div class="subquestion-row">
          <div class="subquestion-main"><h4>43.e. Apakah telah dilaksanakan evaluasi terhadap pelaksanaan kerja sama?</h4><div class="field"><label>Status evaluasi</label><select name="ind_43e_status"><option value="">Pilih...</option><option value="ya" <%= data.ind_43e_status==='ya'?'selected':'' %>>Ya</option><option value="tidak" <%= data.ind_43e_status==='tidak'?'selected':'' %>>Tidak</option></select></div></div>
          <div class="subquestion-upload"><%- include('_question-evidence', { question: bQuestionByNumber[43], evidenceItems: evidenceFor(43, 'ind_43e'), uploadedFiles, evaluationLocked: bEvaluationLocked, compact: true, showTitle: false }) %></div>
        </div>
      </div>
    </section>

    <div class="btn-group"><button class="btn draft" name="save_action" value="draft">💾 Simpan Draft</button><button class="btn primary" name="save_action" value="final">✅ Kirim Final</button><a class="btn secondary" href="/dashboard">Kembali</a></div>
  </form></div>
</div>
<script>
(function(){
  const numberValue = element => {
    if (!element || element.value === '') return null;
    const value = Number(element.value);
    return Number.isFinite(value) ? value : null;
  };
  const activateRubric = (table, value) => {
    if (!table) return null;
    let active = null;
    table.querySelectorAll('.rubric-row').forEach(row => {
      const min = Number(row.dataset.min);
      const max = Number(row.dataset.max);
      const match = value !== null && value >= min && value <= max;
      row.classList.toggle('is-active', match);
      if (match) active = row;
    });
    return active;
  };
  const updateCountRubric = number => {
    const input = document.querySelector(`[data-count-rubric="${number}"]`);
    const table = document.querySelector(`[data-rubric-table="${number}"]`);
    activateRubric(table, numberValue(input));
  };
  const updateRatio = number => {
    const numerator = document.querySelector(`[data-ratio-numerator="${number}"]`);
    const denominator = document.querySelector(`[data-ratio-denominator="${number}"]`);
    const top = numberValue(numerator);
    const bottom = numberValue(denominator);
    const pct = top !== null && bottom !== null && bottom > 0 ? Math.max(0, Math.min(100, top / bottom * 100)) : null;
    activateRubric(document.querySelector(`[data-ratio-rubric="${number}"]`), pct);
  };
  const updateChoiceGroup = fieldName => {
    const group = document.querySelector(`[data-choice-group="${fieldName}"]`);
    if (!group) return;
    const checked = group.querySelector(`input[name="${fieldName}"]:checked`);
    group.querySelectorAll('[data-choice-option]').forEach(card => {
      const selected = checked && card.dataset.choiceOption === checked.value;
      card.classList.toggle('is-selected', Boolean(selected));
      card.querySelectorAll('input[type="file"][name]').forEach(input => {
        input.disabled = !selected;
      });
    });
  };
  document.querySelectorAll('[data-choice-group]').forEach(group => {
    const fieldName = group.dataset.choiceGroup;
    group.querySelectorAll(`input[name="${fieldName}"]`).forEach(input => {
      input.addEventListener('change', () => updateChoiceGroup(fieldName));
    });
    updateChoiceGroup(fieldName);
  });
  [28,29,30,31,32,34,35,36,37,38,39,40].forEach(number => {
    document.querySelectorAll(`[data-ratio-numerator="${number}"],[data-ratio-denominator="${number}"]`).forEach(input => input.addEventListener('input', () => updateRatio(number)));
    updateRatio(number);
  });
})();
</script>
</body></html>
