              <input type="number" name="ind_7a_jumlah" min="0" value="<%= data.ind_7a_jumlah || '' %>">
            </div>
            <div class="form-row">
              <label>7b. Kasus trantibum dipantau penyelesaiannya</label>
              <input type="number" name="ind_7b_jumlah" min="0" value="<%= data.ind_7b_jumlah || '' %>">
            </div>
          </div>
        </div>

        <!-- Indikator 8 -->
        <div class="indicator-group">
          <h4>8. Koordinasi/Sinergi Perencanaan</h4>
          <div class="sub-section">
            <div class="form-row">
              <label>8a. Jumlah pertemuan koordinasi perencanaan</label>
              <input type="number" name="ind_8a_jumlah" min="0" value="<%= data.ind_8a_jumlah || '' %>">
            </div>
            <div class="form-row">
              <label>8b. Laporan hasil koordinasi yang ditindaklanjuti</label>
              <input type="number" name="ind_8b_jumlah" min="0" value="<%= data.ind_8b_jumlah || '' %>">
            </div>
          </div>
        </div>

        <!-- Indikator 9 -->
