            </div>
            <div class="form-row">
              <label>16b1. Evaluasi Rancangan Perdes APBDesa</label>
              <input type="number" name="ind_16b1_jumlah" min="0" value="<%= data.ind_16b1_jumlah || '' %>">
            </div>
            <div class="form-row">
              <label>16b2. Evaluasi Pengelolaan Keuangan & Aset</label>
              <input type="number" name="ind_16b2_jumlah" min="0" value="<%= data.ind_16b2_jumlah || '' %>">
            </div>
            <div class="form-row">
              <label>16b3. Evaluasi LPJ APBDesa</label>
              <input type="number" name="ind_16b3_jumlah" min="0" value="<%= data.ind_16b3_jumlah || '' %>">
            </div>
