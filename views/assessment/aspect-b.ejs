            </div>
            <div class="form-row">
              <label>4b. Rekomendasi pertemuan yang ditindaklanjuti</label>
              <input type="number" name="ind_4b_jumlah" min="0" value="<%= data.ind_4b_jumlah || '' %>">
            </div>
          </div>
        </div>

        <!-- Indikator 5 -->
        <div class="indicator-group">
          <h4>5. Peningkatan Efektifitas Kegiatan Pemerintahan</h4>
          <div class="form-row">
            <label>Persentase Pertemuan Rutin Camat & Aparatur yang ditindaklanjuti</label>
            <input type="number" name="ind_5_persen" min="0" max="100" step="0.01" value="<%= data.ind_5_persen || '' %>">
          </div>
        </div>

        <!-- Indikator 6 -->
        <div class="indicator-group">
          <h4>6. Permasalahan Trantib yang Diselesaikan</h4>
