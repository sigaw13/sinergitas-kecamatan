              <select name="ind_41_nilai">
                <option value="A" <%= data.ind_41_nilai === 'A' ? 'selected' : '' %>>A</option>
                <option value="B" <%= data.ind_41_nilai === 'B' ? 'selected' : '' %>>B</option>
                <option value="C" <%= data.ind_41_nilai === 'C' ? 'selected' : '' %>>C</option>
                <option value="D" <%= data.ind_41_nilai === 'D' ? 'selected' : '' %>>D</option>
