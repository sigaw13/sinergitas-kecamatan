              <select name="ind_10c_status">
                <option value="ada" <%= data.ind_10c_status === 'ada' ? 'selected' : '' %>>Ada</option>
                <option value="tidak" <%= data.ind_10c_status === 'tidak' ? 'selected' : '' %>>Tidak</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Indikator 11 -->
        <div class="indicator-group">
