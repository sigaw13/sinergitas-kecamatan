            <label>Jumlah Permasalahan Trantib Tahun 2025</label>
            <input type="number" name="ind_6_jumlah" min="0" value="<%= data.ind_6_jumlah || '' %>">
          </div>
        </div>

        <!-- Indikator 7 -->
