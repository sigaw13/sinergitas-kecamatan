            <div class="form-row">
              <label>11a. Dokumen Standar Pelayanan dengan Masyarakat</label>
              <input type="number" name="ind_11a_jumlah" min="0" value="<%= data.ind_11a_jumlah || '' %>">
            </div>
            <div class="form-row">
              <label>11b. Dialog Monitoring Pelaksanaan Standar Pelayanan</label>
              <input type="number" name="ind_11b_jumlah" min="0" value="<%= data.ind_11b_jumlah || '' %>">
            </div>
          </div>
        </div>

        <!-- Indikator 12 -->
        <div class="indicator-group">
          <h4>12. Harmonisasi Tokoh Agama & Masyarakat</h4>
          <div class="sub-section">
            <div class="form-row">
              <label>12a. Fasilitasi FKUB Kecamatan</label>
              <input type="number" name="ind_12a_jumlah" min="0" value="<%= data.ind_12a_jumlah || '' %>">
            </div>
            <div class="form-row">
