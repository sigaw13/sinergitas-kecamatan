<% if (typeof progress !== 'undefined' && progress) { %>
  <div style="background:#ffffff;border-radius:10px;padding:16px 18px;margin-bottom:18px;box-shadow:0 2px 10px rgba(0,0,0,.08);border-left:5px solid #5d73df;">
    <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;">
      <div>
        <strong>Progres Instrumen <%= progress.instrument %>: <%= progress.percent %>%</strong>
        <div style="font-size:12px;color:#667085;margin-top:4px;">Isian <%= progress.dataFilled %> dari <%= progress.dataTotal %> · Bukti <%= progress.evidenceFilled %> dari <%= progress.evidenceTotal %></div>
      </div>
      <div style="min-width:260px;flex:1;max-width:520px;background:#e8ebf2;height:20px;border-radius:999px;overflow:hidden;">
        <div style="width:<%= progress.percent %>%;height:100%;background:linear-gradient(90deg,#5d73df,#7047a5);color:#fff;text-align:center;line-height:20px;font-size:11px;font-weight:700;"><%= progress.percent %>%</div>
      </div>
    </div>
  </div>
<% } %>

<% if (typeof lockReason !== 'undefined' && lockReason) { %>
  <div role="alert" style="background:#fff4e5;border:1px solid #f5c26b;border-left:5px solid #d97706;border-radius:10px;padding:14px 16px;margin-bottom:18px;color:#7c2d12;">
    <strong>🔒 Pengisian dikunci.</strong>
    <span><%= lockReason %></span>
  </div>
<% } %>

<% if (typeof deadlineLocked !== 'undefined' && deadlineLocked) { %>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('form[enctype="multipart/form-data"] input, form[enctype="multipart/form-data"] select, form[enctype="multipart/form-data"] textarea, form[enctype="multipart/form-data"] button')
        .forEach(function (control) {
          control.disabled = true;
          control.setAttribute('aria-disabled', 'true');
        });
    });
  </script>
<% } %>
