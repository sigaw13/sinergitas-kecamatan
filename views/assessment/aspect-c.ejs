<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Instrumen C - Pengelolaan Anggaran</title>
  <style>
    /* Menggunakan style yang konsisten */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f5f7fa; padding: 20px; }
    .container { max-width: 1100px; margin: 0 auto; }
    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 25px; border-radius: 10px; margin-bottom: 25px; text-align: center; }
    .header h1 { font-size: 24px; margin-bottom: 8px; }
    .form-container { background: white; padding: 30px; border-radius: 10px; box-shadow: 0 2px 15px rgba(0,0,0,0.1); }
    .indicator-group { margin-bottom: 20px; padding: 15px; background: #f8f9fa; border-radius: 8px; border-left: 4px solid #667eea; }
    .indicator-group h4 { color: #333; margin-bottom: 10px; font-size: 15px; border-bottom: 1px solid #e9ecef; padding-bottom: 8px; }
    .form-row { margin-bottom: 10px; padding: 8px; background: white; border-radius: 5px; }
    .form-row label { display: block; margin-bottom: 5px; color: #444; font-weight: 500; font-size: 13px; }
    select, input[type="number"], input[type="text"] { width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px; }
    .file-upload { margin-top: 8px; padding: 8px; background: #e9ecef; border-radius: 4px; }
    .file-upload input[type="file"] { width: 100%; font-size: 12px; }
    .btn-group { display: flex; gap: 15px; margin-top: 25px; justify-content: center; }
    .btn { padding: 10px 25px; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; transition: transform 0.2s; }
    .btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
    .btn-secondary { background: #6c757d; color: white; }
    .btn:hover { transform: translateY(-2px); }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>💰 Instrumen C - Pengelolaan Anggaran</h1>
      <p>Kecamatan <%= kecamatan %></p>
    </div>
      <!-- Tampilkan file yang sudah diupload -->
<% if (data && data.upload_status === 'Sudah') { %>
  <div class="uploaded-files" style="background: #d4edda; padding: 20px; border-radius: 10px; margin-bottom: 20px; border-left: 4px solid #28a745;">
    <h3 style="color: #155724; margin-bottom: 15px;">📎 File yang Sudah Diupload</h3>
    <div id="fileList" style="color: #155724;">
      <p>Memuat daftar file...</p>
    </div>
  </div>

  <script>
    // Load file list
    const kecamatanId = '<%= typeof kecamatan_id !== "undefined" ? kecamatan_id : "" %>';

fetch('/assessment/files/c?kecamatan_id=' + encodeURIComponent(kecamatanId))
      .then(res => res.json())
      .then(data => {
        const fileList = document.getElementById('fileList');
        if (data.files && data.files.length > 0) {
          let html = '<ul style="list-style: none; padding: 0;">';
          data.files.forEach(file => {
            html += `
              <li style="padding: 8px; background: white; margin-bottom: 5px; border-radius: 5px; display: flex; justify-content: space-between; align-items: center;">
                <span>📄 ${file.fieldName.replace('ind_', 'Indikator ').replace('_file', '')}: <strong>${file.fileName}</strong></span>
                <a href="${file.url}" target="_blank" style="color: #667eea; text-decoration: none; font-weight: 600;">👁️ Lihat</a>
              </li>
            `;
          });
          html += '</ul>';
          fileList.innerHTML = html;
        } else {
          fileList.innerHTML = '<p>Belum ada file yang diupload</p>';
        }
      })
      .catch(err => {
        document.getElementById('fileList').innerHTML = '<p>Error memuat file</p>';
      });
  </script>
<% } %>
    <div class="form-container">
      <form action="/assessment/aspect-c<%= kecamatan_id ? '?kecamatan_id=' + kecamatan_id : '' %>" method="POST" enctype="multipart/form-data">
        
        <!-- Indikator 1: Dokumen Perencanaan -->
        <div class="indicator-group">
          <h4>1. Dokumen Perencanaan dan Anggaran Kecamatan</h4>
          <div class="form-row">
            <label>1.a Laporan Keuangan (LRA, CALK & Neraca)</label>
            <select name="ind_1a">
              <option value="">Pilih...</option>
              <option value="ya" <%= data && data.ind_1a === 'ya' ? 'selected' : '' %>>Ada</option>
              <option value="tidak" <%= data && data.ind_1a === 'tidak' ? 'selected' : '' %>>Tidak Ada</option>
            </select>
          </div>
          <div class="form-row">
            <label>1.b Rencana Kerja (Renja)</label>
            <select name="ind_1b">
              <option value="">Pilih...</option>
              <option value="ya" <%= data && data.ind_1b === 'ya' ? 'selected' : '' %>>Ada</option>
              <option value="tidak" <%= data && data.ind_1b === 'tidak' ? 'selected' : '' %>>Tidak Ada</option>
            </select>
          </div>
          <div class="form-row">
            <label>1.c Rencana Strategis (Renstra)</label>
            <select name="ind_1c">
              <option value="">Pilih...</option>
              <option value="ya" <%= data && data.ind_1c === 'ya' ? 'selected' : '' %>>Ada</option>
              <option value="tidak" <%= data && data.ind_1c === 'tidak' ? 'selected' : '' %>>Tidak Ada</option>
            </select>
          </div>
          <div class="form-row">
            <label>1.d Daftar Pelaksanaan Anggaran (DPA)</label>
            <select name="ind_1d">
              <option value="">Pilih...</option>
              <option value="ya" <%= data && data.ind_1d === 'ya' ? 'selected' : '' %>>Ada</option>
              <option value="tidak" <%= data && data.ind_1d === 'tidak' ? 'selected' : '' %>>Tidak Ada</option>
            </select>
          </div>
          <div class="file-upload">
            <label> Upload Dokumen 1:</label>
            <input type="file" name="file_1" accept=".pdf,.doc,.docx,.jpg,.png">
          </div>
        </div>

        <!-- Indikator 2: Kesesuaian Program -->
        <div class="indicator-group">
          <h4>2. Kesesuaian Nama dan Jumlah Program</h4>
          <div class="form-row">
            <label>2.a Jumlah Program dan Indikator dalam Renja</label>
            <input type="number" name="ind_2a" min="0" value="<%= data && data.ind_2a ? data.ind_2a : '' %>" placeholder="Masukkan jumlah">
          </div>
          <div class="form-row">
            <label>2.b Jumlah Program dan Indikator dalam DPA</label>
            <input type="number" name="ind_2b" min="0" value="<%= data && data.ind_2b ? data.ind_2b : '' %>" placeholder="Masukkan jumlah">
          </div>
          <div class="file-upload">
            <label>📎 Upload Dokumen 2:</label>
            <input type="file" name="file_2" accept=".pdf,.xlsx,.jpg,.png">
          </div>
        </div>

        <!-- Indikator 3 & 4: Persentase & Prioritas -->
        <div class="indicator-group">
          <h4>3. Persentase Anggaran per Kegiatan</h4>
          <div class="form-row"><label>3.a Trantibum (%)</label><input type="number" step="0.01" name="ind_3a" value="<%= data && data.ind_3a ? data.ind_3a : '' %>"></div>
          <div class="form-row"><label>3.b Pemberdayaan Masyarakat (%)</label><input type="number" step="0.01" name="ind_3b" value="<%= data && data.ind_3b ? data.ind_3b : '' %>"></div>
          <div class="form-row"><label>3.c Pelayanan Publik (%)</label><input type="number" step="0.01" name="ind_3c" value="<%= data && data.ind_3c ? data.ind_3c : '' %>"></div>
          <div class="form-row"><label>3.d Penegakan Aturan Perda (%)</label><input type="number" step="0.01" name="ind_3d" value="<%= data && data.ind_3d ? data.ind_3d : '' %>"></div>
          <div class="form-row"><label>3.e Pemeliharaan Sarana Umum (%)</label><input type="number" step="0.01" name="ind_3e" value="<%= data && data.ind_3e ? data.ind_3e : '' %>"></div>
          <div class="form-row"><label>3.f Penyelenggaraan Pemerintahan (%)</label><input type="number" step="0.01" name="ind_3f" value="<%= data && data.ind_3f ? data.ind_3f : '' %>"></div>
          
          <h4 style="margin-top:15px;">4. Prioritas Kegiatan</h4>
          <div class="form-row">
            <label>Urutkan kegiatan yang dijadikan prioritas (sebutkan)</label>
            <textarea name="ind_4" rows="3" placeholder="Contoh: 1. Pelayanan Publik, 2. Trantibum..."><%= data && data.ind_4 ? data.ind_4 : '' %></textarea>
          </div>
          
          <div class="file-upload">
            <label>📎 Upload Dokumen 3 & 4:</label>
            <input type="file" name="file_3" accept=".pdf,.xlsx,.jpg,.png">
          </div>
        </div>

        <!-- Indikator 5: Bobot Pelaksanaan -->
        <div class="indicator-group">
          <h4>5. Bobot Nilai Pelaksanaan Kegiatan</h4>
          <div class="form-row"><label>5.a Trantibum (%)</label><input type="number" step="0.01" name="ind_5a" value="<%= data && data.ind_5a ? data.ind_5a : '' %>"></div>
          <div class="form-row"><label>5.b Pemberdayaan Masyarakat (%)</label><input type="number" step="0.01" name="ind_5b" value="<%= data && data.ind_5b ? data.ind_5b : '' %>"></div>
          <div class="form-row"><label>5.c Pelayanan Publik (%)</label><input type="number" step="0.01" name="ind_5c" value="<%= data && data.ind_5c ? data.ind_5c : '' %>"></div>
          <div class="form-row"><label>5.d Penegakan Aturan Perda (%)</label><input type="number" step="0.01" name="ind_5d" value="<%= data && data.ind_5d ? data.ind_5d : '' %>"></div>
          <div class="form-row"><label>5.e Pemeliharaan Sarana Umum (%)</label><input type="number" step="0.01" name="ind_5e" value="<%= data && data.ind_5e ? data.ind_5e : '' %>"></div>
          <div class="form-row"><label>5.f Penyelenggaraan Pemerintahan (%)</label><input type="number" step="0.01" name="ind_5f" value="<%= data && data.ind_5f ? data.ind_5f : '' %>"></div>
          <div class="form-row"><label>5.g Lain-lain (%)</label><input type="number" step="0.01" name="ind_5g" value="<%= data && data.ind_5g ? data.ind_5g : '' %>"></div>
          <div class="file-upload">
            <label>📎 Upload Dokumen 5:</label>
            <input type="file" name="file_5" accept=".pdf,.xlsx,.jpg,.png">
          </div>
        </div>

        <!-- Indikator 6: Realisasi Anggaran -->
        <div class="indicator-group">
          <h4>6. Realisasi Anggaran</h4>
          <div class="form-row">
            <label>6.a Jumlah Realisasi (Rp)</label>
            <input type="number" name="ind_6a" min="0" value="<%= data && data.ind_6a ? data.ind_6a : '' %>" placeholder="Contoh: 150000000">
          </div>
          <div class="form-row">
            <label>6.b Jumlah Anggaran (Rp)</label>
            <input type="number" name="ind_6b" min="0" value="<%= data && data.ind_6b ? data.ind_6b : '' %>" placeholder="Contoh: 200000000">
          </div>
          <div class="file-upload">
            <label>📎 Upload Dokumen 6 (LRA):</label>
            <input type="file" name="file_6" accept=".pdf,.xlsx,.jpg,.png">
          </div>
        </div>

        <div class="btn-group">
          <button type="submit" class="btn btn-primary">💾 Simpan Data Instrumen C</button>
          <a href="/dashboard" class="btn btn-secondary">← Kembali</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>