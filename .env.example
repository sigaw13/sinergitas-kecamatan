NODE_ENV=development
PORT=3000
SESSION_SECRET=ganti-dengan-rangkaian-acak-yang-panjang
ALLOWED_ORIGINS=
# Kosongkan DATABASE_URL untuk menggunakan SQLite lokal.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Lokal Windows, contoh: UPLOADS_DIR=F:/sinergitas-kecamatan_offline/uploads
# Railway Volume: UPLOADS_DIR=/app/uploads
UPLOADS_DIR=./uploads
DEFAULT_DEADLINE=2026-12-31
MAX_FILE_MB=10
MAX_UPLOAD_REQUEST_MB=100
# Lokasi arsip backup. Biarkan default jika tidak perlu dipindahkan.
BACKUP_DIR=./backups
# Batas maksimum berkas restore dalam megabita.
MAX_RESTORE_MB=2048
INITIAL_ADMIN_PASSWORD=ganti-sebelum-deploy
INITIAL_USER_PASSWORD_SUFFIX=123
