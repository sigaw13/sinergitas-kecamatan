# SI ESELON Preview Evaluator
# Railway local disk tidak persistent. Untuk production gunakan supabase.
FILE_STORAGE_PROVIDER=supabase

# Supabase Storage
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_bukan_anon_key
SUPABASE_BUCKET=sieselon-bukti

# Fallback local hanya untuk development lokal
LOCAL_UPLOAD_DIR=uploads
